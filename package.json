{
  "name": "@rockcarver/frodo-cli",
  "version": "5.0.0-1",
  "type": "module",
  "description": "A command line interface to manage ForgeRock Identity Cloud tenants, ForgeOps deployments, and classic deployments.",
  "keywords": [
    "ping",
    "pingone",
    "forgerock",
    "cli",
    "am",
    "openam",
    "idm",
    "openidm",
    "forgeops",
    "identity cloud",
    "advanced identity cloud",
    "export",
    "import",
    "ci/cd",
    "devops"
  ],
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rockcarver/frodo-cli.git"
  },
  "bugs": {
    "url": "https://github.com/rockcarver/frodo-cli/issues"
  },
  "main": "dist/launch.cjs",
  "files": [
    "dist/app.cjs",
    "dist/app.cjs.map",
    "dist/launch.cjs",
    "dist/launch.cjs.map",
    "dist/loader.cjs",
    "dist/loader.cjs.map",
    "dist/rolldown-runtime-*.cjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "npm run test:only",
    "test:only": "FRODO_TEST=1 NO_COLOR=1 NODE_OPTIONS='--no-warnings --experimental-vm-modules' node tools/with-frodo-bin.mjs npx jest --silent",
    "test:binary": "FRODO_TEST=1 FRODO_TEST_BINARY=sea NO_COLOR=1 NODE_OPTIONS='--no-warnings --experimental-vm-modules' node tools/with-frodo-bin.mjs npx jest --silent",
    "test:parallel": "FRODO_TEST=1 NO_COLOR=1 NODE_OPTIONS='--no-warnings --experimental-vm-modules' node tools/with-frodo-bin.mjs npx jest --silent --maxWorkers=4",
    "test:serial": "FRODO_TEST=1 NO_COLOR=1 NODE_OPTIONS='--no-warnings --experimental-vm-modules' node tools/with-frodo-bin.mjs npx jest --silent --runInBand",
    "test:debug": "FRODO_TEST=1 NO_COLOR=1 NODE_OPTIONS='--no-warnings --experimental-vm-modules' node tools/with-frodo-bin.mjs npx jest --silent=false --json --outputFile=./testResults.json",
    "test:update": "FRODO_TEST=1 NO_COLOR=1 NODE_OPTIONS='--no-warnings --experimental-vm-modules' node tools/with-frodo-bin.mjs npx jest --silent=false --updateSnapshot",
    "test:record:cloud": "node tools/record-cloud-e2e.mjs",
    "mcp:batch1": "node tools/mcp-agentic-batch-run.mjs --output tools/reports/mcp-agentic-run-log.batch1.json",
    "mcp:batch2": "node tools/mcp-agentic-batch-run.mjs --batch batch2 --output tools/reports/mcp-agentic-run-log.batch2.json",
    "mcp:batch3": "node tools/mcp-agentic-batch-run.mjs --batch batch3 --output tools/reports/mcp-agentic-run-log.batch3.json",
    "mcp:batch4": "node tools/mcp-agentic-batch-run.mjs --batch batch4 --output tools/reports/mcp-agentic-run-log.batch4.json",
    "mcp:score": "node tools/mcp-agentic-score.mjs",
    "mcp:assess": "node tools/mcp-agentic-assess.mjs",
    "mcp:test-aiagents": "node tools/mcp-aiagent-introspection-test.mjs",
    "mcp:test-oauth2-mayact": "node tools/mcp-oauth2-mayact-update-test.mjs",
    "check:mcp-sdk-track": "node tools/check-mcp-sdk-track.mjs",
    "lint": "npm run check",
    "lint:fix": "npm run fix",
    "fix": "eslint --fix \"src/**/*.ts\" && prettier --write \"src/**/*.ts\"",
    "check": "eslint \"src/**/*.ts\" && prettier --check \"src/**/*.ts\"",
    "build": "npm run build:binary",
    "build:only": "npx tsdown && npx tsc",
    "build:binary": "npm run build:only && npm run build:sea",
    "build:sea": "node scripts/build-sea.mjs",
    "build:sea-bundle": "npx tsdown --config tsdown.sea.config.mts",
    "link": "npm link ../frodo-lib",
    "dev": "npx tsdown --watch src"
  },
  "jest": {
    "testTimeout": 120000,
    "testMatch": [
      "**/?(*.)(test).js",
      "**/?(*.)(test).ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "globalSetup": "./global-jest-setup.js"
  },
  "contributors": [
    {
      "name": "Sandeep Chaturvedi",
      "email": "sandeep.chaturvedi@forgerock.com"
    },
    {
      "name": "Huston Franklin",
      "email": "hfranklin@trivir.com"
    },
    {
      "name": "Preston Hales",
      "email": "phales@trivir.com"
    },
    {
      "name": "Joshua Sayers",
      "email": "joshua.sayers@forgerock.com"
    },
    {
      "name": "Volker Scheuber",
      "email": "volker.scheuber@forgerock.com"
    }
  ],
  "license": "MIT",
  "bin": {
    "frodo": "dist/launch.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@inquirer/confirm": "6.3.2",
    "@inquirer/core": "^12.0.1",
    "@inquirer/select": "^5.2.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@rockcarver/frodo-lib": "4.12.0-1",
    "@types/colors": "^1.2.1",
    "@types/fs-extra": "^11.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "chokidar": "^5.0.0",
    "cli-progress": "^3.11.2",
    "cli-table3": "^0.6.3",
    "commander": "^15.0.0",
    "compare-versions": "^6.1.0",
    "copyfiles": "^2.4.1",
    "del": "^8.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "fs-extra": "^11.1.1",
    "jest": "30.5.2",
    "log-update": "^4.0.0",
    "loglevel": "^1.9.1",
    "map-stream": "^0.0.7",
    "open": "^11.0.2",
    "prettier": "3.9.9",
    "properties-reader": "^3.0.1",
    "replaceall": "^0.1.6",
    "resolve": "^1.22.1",
    "rimraf": "^6.0.1",
    "sanitize-filename": "^1.6.3",
    "slugify": "^1.6.5",
    "tinyrainbow": "^3.0.3",
    "tmp": "^0.2.3",
    "ts-jest": "^29.1.4",
    "tsdown": "0.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true
  }
}
