// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'config-manager push oauth-software-publishers' should be expected english 1`] = `
"Usage: frodo config-manager push oauth-software-publishers [options] [host] [realm] [username] [password]

[Experimental] Import OAuth2 software publishers from the files
realms/<realm>/realm-config/agents/SoftwarePublisher/<name>.json that "pull
oauth-software-publishers" and "pull oauth2-agents" write, from the working
directory (-D). A publisher that does not exist is created and one that does is
replaced by the file. A realm that does not offer the agent type is skipped with
a warning. Each \${NAME} is filled from -E/--env NAME=value, else from
--env-file, else from the environment variable NAME of the process (a file that
names a variable copies its value into what is pushed). A file that has
\${<ID>_JWKSET} as its key set (a pull writes it for a key set with a private or
secret key) is filled from that variable, which holds the key set as JSON text.
No publisher is ever deleted. A software publisher is a trust anchor: a software
statement it signs is accepted when a client registers itself, so read the files
before you push them.

Arguments:
  host               AM base URL, e.g.: https://cdk.iam.example.com/am. To use a
                     connection profile, just specify a unique substring or
                     alias.
  realm              Realm. Specify realm as '/' for the root realm or 'realm'
                     or '/parent/child' otherwise. (default: "alpha" for
                     Identity Cloud tenants, "/" otherwise.)
  username           Username to login with. Must be an admin user with
                     appropriate rights to manage authentication journeys/trees.
                     If given without a password, and it matches the username
                     already stored in the connection profile for the target
                     host, frodo uses that profile's stored password instead of
                     requiring it on the command line.
  password           Password.

Options:
  --allow-failures   Report operations that fail, but still exit with code 0.
                     Without this option the command runs every operation,
                     prints a summary of what failed and exits with code 1.
  -n, --name <name>  Software publisher name (the name of the object). If
                     specified, pushes only the publisher of the file with that
                     name. Needs a single realm.
  -h, --help         Help
  -hh, --help-more   Help with all options.
  -hhh, --help-all   Help with all options, environment variables, and usage
                     examples.
"
`;
