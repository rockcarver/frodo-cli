// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'config-manager pull agents' should be expected english 1`] = `
"Usage: frodo config-manager pull agents [options] [host] [realm] [username] [password]

[Experimental] Export the agents (the gateway, Java, web and policy agents and
the other agent types listed below, but not the OAuth2 clients) of all realms or
of one realm to realms/<realm>/realm-config/agents/<type>/<id>.json, one file
for each. The files are the ones that the deprecated "pull oauth2-agents" writes
for these agents, at the same paths. The OAuth2 clients are pulled by "pull
oauth-clients".

Arguments:
  host                  AM base URL, e.g.: https://cdk.iam.example.com/am. To
                        use a connection profile, just specify a unique
                        substring or alias.
  realm                 Realm. Specify realm as '/' for the root realm or
                        'realm' or '/parent/child' otherwise. (default: "alpha"
                        for Identity Cloud tenants, "/" otherwise.)
  username              Username to login with. Must be an admin user with
                        appropriate rights to manage authentication
                        journeys/trees. If given without a password, and it
                        matches the username already stored in the connection
                        profile for the target host, frodo uses that profile's
                        stored password instead of requiring it on the command
                        line.
  password              Password.

Options:
  --allow-failures      Report operations that fail, but still exit with code 0.
                        Without this option the command runs every operation,
                        prints a summary of what failed and exits with code 1.
  --config-file <file>  A JSON file that lists the agents to pull for each
                        realm, with overrides. ex: "oauth2-agents.json". Without
                        it, every agent of every realm is pulled. The realm
                        argument narrows a pull without a file; with a file the
                        realms of the file are pulled and the realm argument is
                        not used. Cannot be used with -i.
  -i, --agent-id <id>   Agent id. If specified, pulls only that agent. Needs a
                        single realm (the realm argument); an id that more than
                        one agent of the realm has fails and names them. Cannot
                        be used with --config-file.
  -h, --help            Help
  -hh, --help-more      Help with all options.
  -hhh, --help-all      Help with all options, environment variables, and usage
                        examples.
"
`;
