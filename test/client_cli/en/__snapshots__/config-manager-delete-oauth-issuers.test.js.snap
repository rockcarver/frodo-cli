// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'config-manager delete oauth-issuers' should be expected english 1`] = `
"Usage: frodo config-manager delete oauth-issuers [options] [host] [realm] [username] [password]

[Experimental] Delete OAuth2 trusted JWT issuers from the tenant, by name or all
of the selected realms. A trusted JWT issuer is a trust anchor: a JWT signed by
it is accepted as a grant, and once it is deleted that JWT is rejected until an
issuer for it exists again. There is no undo; a tree in version control holds
the files to push back.

Arguments:
  host               AM base URL, e.g.: https://cdk.iam.example.com/am. To use a
                     connection profile, just specify a unique substring or
                     alias.
  realm              Realm. Specify realm as '/' for the root realm or 'realm'
                     or '/parent/child' otherwise. (default: "alpha" for
                     Identity Cloud tenants, "/" otherwise.)
  username           Username to login with. Must be an admin user with
                     appropriate rights to manage authentication journeys/trees.
                     If given without a password, and it matches the username
                     already stored in the connection profile for the target
                     host, frodo uses that profile's stored password instead of
                     requiring it on the command line.
  password           Password.

Options:
  --allow-failures   Report operations that fail, but still exit with code 0.
                     Without this option the command runs every operation,
                     prints a summary of what failed and exits with code 1.
  --dry-run          Show which trusted JWT issuers would be deleted without
                     deleting them.
  -n, --name <name>  Trusted JWT issuer name (the name of the object, not its
                     iss URL). If specified, deletes only that issuer, without
                     asking. Needs a single realm.
  -y, --yes          Do not ask for confirmation before deleting more than one
                     trusted JWT issuer (no -n). Required without a terminal.
  -h, --help         Help
  -hh, --help-more   Help with all options.
  -hhh, --help-all   Help with all options, environment variables, and usage
                     examples.
"
`;
