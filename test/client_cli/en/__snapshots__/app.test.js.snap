exports[`CLI help interface for 'app' should be expected english 1`] = `
"Usage: frodo app [options] [command]

Manage applications.

Options:
  -h, --help        Help
  -hh, --help-more  Help with all options.
  -hhh, --help-all  Help with all options, environment variables, and usage
                    examples.

Runtime Options:
  --no-prompt       Never prompt interactively (same as setting
                    FRODO_NO_PROMPT).

Commands:
  delete            Delete applications.
  export            Export applications.
  import            Import applications.
  list              List applications.

Utilities:
  help              display help for command


Run without a sub-command to enter interactive mode."
`;
