exports[`CLI help interface for 'authz policy' should be expected english 1`] = `
"Usage: frodo authz policy [options] [command]

Manages authorization policies.

Options:
  -h, --help        Help
  -hh, --help-more  Help with all options.
  -hhh, --help-all  Help with all options, environment variables, and usage
                    examples.

Runtime Options:
  --no-prompt       Never prompt or pick; behave as before the interactive
                    framework (same as setting FRODO_NO_PROMPT).

Commands:
  delete            Delete authorization policies.
  describe          Describe authorization policies.
  export            Export authorization policies.
  import            Import authorization policies.
  list              List authorization policies.

Utilities:
  help              display help for command


Run without a sub-command to enter interactive mode."
`;
