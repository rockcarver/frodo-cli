// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'config-manager delete' should be expected english 1`] = `
"Usage: frodo config-manager delete [options] [command]

[Experimental] Delete configuration optimized for CI/CD pipelines (format
compatible with fr-config-manager).

Options:
  -h, --help                 Help
  -hh, --help-more           Help with all options.
  -hhh, --help-all           Help with all options, environment variables, and
                             usage examples.

Runtime Options:
  --no-prompt                Never prompt interactively (same as setting
                             FRODO_NO_PROMPT).

Commands:
  apps                       [Experimental] Delete applications together with
                             the objects they own. (formerly: applications)
  connector-mappings         [Experimental] Delete one connector mapping by
                             name, or delete all connector mappings of the sync
                             configuration. A connector mapping that other
                             objects still name is not deleted without --force.
  connector-servers          [Experimental] Delete one connector server by name,
                             or delete all of them. A connector server that a
                             server cluster or a connector still names is not
                             deleted without --force. (formerly: remote-servers)
  connectors                 [Experimental] Delete one connector definition by
                             id, or delete all connector definitions. A
                             connector definition that other objects still name
                             is not deleted without --force. (formerly:
                             connector-definitions)
  cors                       [Experimental] Delete CORS configurations.
  email-templates            [Experimental] Delete email template objects.
  endpoints                  [Experimental] Delete custom endpoint objects.
  journeys                   [Experimental] Delete one journey by id, or delete
                             all journeys and clean up orphaned nodes in the
                             selected realms. A journey that other objects still
                             name is not deleted without --force.
  locales                    [Experimental] Delete locale objects.
  nodes                      [Experimental] Delete custom nodes. (formerly:
                             custom-nodes)
  oauth-cimd-profiles        [Experimental] Delete CIMD profiles.
  oauth-issuers              [Experimental] Delete trusted JWT issuers.
  oauth-software-publishers  [Experimental] Delete software publishers.
  schedules                  [Experimental] Delete schedules.
  scripts                    [Experimental] Delete AM scripts. Default scripts
                             are never deleted.
  secrets                    [Experimental] [Cloud-only] Delete secrets.
  secretstore-mappings       [Experimental] [Cloud-only] Delete secret mappings.
                             (formerly: secret-mappings)
  services                   [Experimental] Delete realm services.
  telemetry                  [Experimental] [Cloud-only] Delete telemetry
                             exporters.
  tenant-config              [Experimental] [Cloud-only] Delete all ESV secrets
                             and all ESV variables of the tenant, and nothing
                             else. Deleted secret values cannot be recovered.
  terms-and-conditions       [Experimental] Delete terms and conditions
                             versions.
  themes                     [Experimental] Delete themes by id or by name, or
                             delete all themes in the selected realms.
  variables                  [Experimental] [Cloud-only] Delete variables.

Utilities:
  help                       display help for command


Run without a sub-command to enter interactive mode."
`;
