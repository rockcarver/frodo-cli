// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'esv secret version prune' should be expected english 1`] = `
"Usage: frodo esv secret version prune [options] [host] [username] [password]

[Cloud-only] Prune versions of secrets. Deletes every version of a secret except
the active version.

Arguments:
  host                         AM base URL, e.g.:
                               https://cdk.iam.example.com/am. To use a
                               connection profile, just specify a unique
                               substring or alias.
  username                     Username to login with. Must be an admin user
                               with appropriate rights to manage authentication
                               journeys/trees. If given without a password, and
                               it matches the username already stored in the
                               connection profile for the target host, frodo
                               uses that profile's stored password instead of
                               requiring it on the command line.
  password                     Password.

Deployment: Cloud-only

Options:
  -a, --all                    Prune all secrets. Shows which versions will be
                               deleted and asks for confirmation (see -y and
                               --dry-run). Cannot be used with -i.
  --dry-run                    Dry-run only, do not delete anything: show which
                               versions would be pruned. Works with -i and -a,
                               and wins over -y.
  -i, --secret-id <secret-id>  Secret id. Cannot be used with -a. (pick from
                               secret)
  --keep-deactivated           Keep the deactivated versions. Only the activated
                               versions other than the active version are
                               pruned.
  --keep-loaded                Keep the versions that are currently loaded,
                               whether they are active or not.
  -y, --yes                    Do not ask for confirmation before pruning all
                               secrets. Required with -a when there is no
                               terminal. Has no effect with -i, which never
                               asks.
  -h, --help                   Help
  -hh, --help-more             Help with all options.
  -hhh, --help-all             Help with all options, environment variables, and
                               usage examples.

Rule:
  one of -i, --secret-id <secret-id> | -a, --all is required -- choose which secrets to prune

"
`;
