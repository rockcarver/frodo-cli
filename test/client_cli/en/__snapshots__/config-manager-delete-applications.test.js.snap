// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'config-manager delete applications' should be expected english 1`] = `
"Usage: frodo config-manager delete applications [options] [host] [realm] [username] [password]

[Experimental] Delete applications: the application record first, then the
objects it owns (the OAuth2 client, the SAML providers, the connector and its
mappings). An owned object that another application still names is kept. The
scripts and circles of trust that an application uses are never deleted. An
application whose connector is active is not deleted: switch it off first with
"frodo app disable". The glossary values and request forms of Identity
Governance tenants are not handled by this command.

Arguments:
  host               AM base URL, e.g.: https://cdk.iam.example.com/am. To use a
                     connection profile, just specify a unique substring or
                     alias.
  realm              Realm. Specify realm as '/' for the root realm or 'realm'
                     or '/parent/child' otherwise. (default: "alpha" for
                     Identity Cloud tenants, "/" otherwise.)
  username           Username to login with. Must be an admin user with
                     appropriate rights to manage authentication journeys/trees.
                     If given without a password, and it matches the username
                     already stored in the connection profile for the target
                     host, frodo uses that profile's stored password instead of
                     requiring it on the command line.
  password           Password.

Options:
  --allow-failures   Report operations that fail, but still exit with code 0.
                     Without this option the command runs every operation,
                     prints a summary of what failed and exits with code 1.
  -d, --dry-run      Show which applications and objects would be deleted
                     without deleting them.
  -n, --name <name>  Application name. If specified, deletes only the
                     application with the given name, without asking. Needs a
                     single realm.
  -y, --yes          Do not ask for confirmation before deleting more than one
                     application (no -n). Required without a terminal.
  -h, --help         Help
  -hh, --help-more   Help with all options.
  -hhh, --help-all   Help with all options, environment variables, and usage
                     examples.
"
`;
