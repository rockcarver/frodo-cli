// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'frodo' root command should be expected english 1`] = `
"Usage: frodo [options] [command]

Options:
  -v, --version     output the version number
  -h, --help        Help
  -hh, --help-more  Help with all options.
  -hhh, --help-all  Help with all options, environment variables, and usage
                    examples.

Commands:
  agent             Manage agents.
  app               Manage applications.
  authn             Manage authentication settings.
  authz             Manage authorization policies, policy sets, and resource
                    types.
  config            Manage full cloud configuration.
  dcc               [Preview] [Cloud-only] Direct Configuration Control (DCC)
                    commands.
  debug             [Experimental] [Cloud-only] Interactively debug Identity
                    Cloud activity
  email             Manage email templates and configuration.
  esv               [Cloud-only] Manage environment secrets and variables
                    (ESVs).
  feature           [Cloud-only] Manage features (e.g. groups, aiagent,
                    am/2fa/profiles).
  help              display help for command
  idm               Manage IDM configuration.
  idp               Manage (social) identity providers.
  iga               [Cloud-only] Manage IGA configuration.
  journey           Manage journeys/trees.
  log               [Cloud-only] List/View Identity Cloud logs
  mapping           Manage IDM mappings.
  node              Manage custom nodes.
  oauth             Manage OAuth2 clients and providers.
  realm             Manage realms.
  role              Manage internal (authorization) roles.
  saml              Manage SAML entity providers and circles of trust.
  script            Manage scripts.
  secretstore       Manage secret stores.
  server            Manage servers.
  service           Manage AM services.
  theme             Manage themes.

Utilities:
  admin             Platform admin tasks.
  conn              Manage connection profiles.
  info              Print versions and tokens.
  login             Authenticate to a cloud, forgeops, or classic deployment.
  mcp               [Experimental] Manage Model Context Protocol (MCP)
                    integrations.
  session           Manage sessions.
  settings          Manage CLI settings.
  shell             [Experimental] Launch the frodo interactive shell.

Continuous integration:
  config-manager    [Experimental] Manage configuration optimized for CI/CD
                    pipelines (format compatible with fr-config-manager).
  promote           Prepares a tenant to be promoted
"
`;
