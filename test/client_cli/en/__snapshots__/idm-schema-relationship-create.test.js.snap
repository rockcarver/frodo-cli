exports[`CLI help interface for 'idm schema relationship create' should be expected english 1`] = `
"Usage: frodo idm schema relationship create [options] [host] [realm] [username] [password]

Create IDM managed object relationship schema definition.

Arguments:
  host                            AM base URL, e.g.:
                                  https://cdk.iam.example.com/am. To use a
                                  connection profile, just specify a unique
                                  substring or alias.
  realm                           Realm. Specify realm as '/' for the root realm
                                  or 'realm' or '/parent/child' otherwise.
                                  (default: "alpha" for Identity Cloud tenants,
                                  "/" otherwise.)
  username                        Username to login with. Must be an admin user
                                  with appropriate rights to manage
                                  authentication journeys/trees. If given
                                  without a password, and it matches the
                                  username already stored in the connection
                                  profile for the target host, frodo uses that
                                  profile's stored password instead of requiring
                                  it on the command line.
  password                        Password.

Options:
  --description <text>            Property description.
  --label <text>                  Resource collection label. Defaults to a
                                  title-cased version of --target-object.
  --many                          This is a to-many (array) relationship.
  --not-validate                  Skip target-existence validation on write.
                                  Default: validated.
  --not-viewable                  Hide this property in the UI. Default:
                                  viewable.
  --notify                        Notify the target object of relationship
                                  changes. Default: false.
  --notify-self                   Notify this object of relationship changes.
                                  Default: false.
  -o, --managed-object <type>     Managed object type.
  -p, --property <name>           Relationship property name.
  --query-fields <csv>            Comma-separated list of fields to fetch from
                                  the target object.
  --query-filter <filter>         Query filter applied against the target
                                  object. Default: "true" (match all).
  --return-by-default             Return this property by default on reads.
                                  Default: false.
  --reverse-description <text>    Reverse side display description.
  --reverse-many                  The reverse side is a to-many (array)
                                  relationship.
  --reverse-property <name>       Also create the reverse side of this
                                  relationship, as this property name on
                                  --target-object, pointing back at
                                  -o/--managed-object.
  --reverse-property-name <name>  Marks this relationship as having a reverse
                                  property of this name on --target-object,
                                  without writing that property. Use
                                  --reverse-property instead to also create it.
  --reverse-query-fields <csv>    Comma-separated list of fields to fetch from
                                  -o/--managed-object, for the reverse side.
  --reverse-single                The reverse side is a to-one (single)
                                  relationship.
  --reverse-title <text>          Reverse side display title. Defaults to a
                                  title-cased version of --reverse-property.
  --searchable                    Mark the property searchable in the UI.
  --single                        This is a to-one (single) relationship.
  --sort-keys <csv>               Comma-separated list of sort keys.
  --target-object <type>          Managed object type this relationship points
                                  to.
  --title <text>                  Display title. Defaults to a title-cased
                                  version of the property name.
  --user-editable                 Allow end users to edit this property.
                                  Default: false.
  -h, --help                      Help
  -hh, --help-more                Help with all options.
  -hhh, --help-all                Help with all options, environment variables,
                                  and usage examples.
"
`;
