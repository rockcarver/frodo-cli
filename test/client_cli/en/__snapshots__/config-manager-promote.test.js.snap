exports[`CLI help interface for 'config promote' should be expected english 1`] = `
"Usage: frodo config promote [options] [command]

[Experimental] [Cloud-only] Promote configuration optimized for CI/CD pipelines
(format compatible with fr-config-manager).

Deployment: Cloud-only

Options:
  -h, --help        Help
  -hh, --help-more  Help with all options.
  -hhh, --help-all  Help with all options, environment variables, and usage
                    examples.

Runtime Options:
  --no-prompt       Never prompt interactively (same as setting
                    FRODO_NO_PROMPT).

Commands:
  dry-run           [Experimental] [Cloud-only] Run a dry-run configuration
                    promotion without applying changes. (formerly:
                    run-dryrun-promotion)
  lock              [Experimental] [Cloud-only] Lock tenants and wait until they
                    are locked. (formerly: lock-tenants)
  lock-status       [Experimental] [Cloud-only] Check the lock status of the
                    environments. (formerly: check-locked-status)
  report            [Experimental] [Cloud-only] Retrieve promotion reports.
                    Defaults to the latest report if no option is specified.
                    (formerly: check-promotion-reports)
  rollback          [Experimental] [Cloud-only] Roll back the previous
                    promotion.
  run               [Experimental] [Cloud-only] Run a configuration promotion.
                    (formerly: run-promotion)
  status            [Experimental] [Cloud-only] Check the current promotion
                    status. (formerly: check-promotion-status)
  unlock            [Experimental] [Cloud-only] Unlock tenants and wait until
                    they are unlocked. (formerly: unlock-tenants)

Utilities:
  help              display help for command


Run without a sub-command to enter interactive mode."
`;
