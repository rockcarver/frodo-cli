// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'config-manager delete oauth-software-publishers' should be expected english 1`] = `
"Usage: frodo config-manager delete oauth-software-publishers [options] [host] [realm] [username] [password]

[Experimental] Delete OAuth2 software publishers from the tenant, by name or all
of the selected realms. A software publisher is a trust anchor: a software
statement it signs is accepted when a client registers itself, and once it is
deleted such a registration is rejected until a publisher for it exists again. A
realm that does not offer the agent type has nothing to delete. There is no
undo; a tree in version control holds the files to push back.

Arguments:
  host               AM base URL, e.g.: https://cdk.iam.example.com/am. To use a
                     connection profile, just specify a unique substring or
                     alias.
  realm              Realm. Specify realm as '/' for the root realm or 'realm'
                     or '/parent/child' otherwise. (default: "alpha" for
                     Identity Cloud tenants, "/" otherwise.)
  username           Username to login with. Must be an admin user with
                     appropriate rights to manage authentication journeys/trees.
                     If given without a password, and it matches the username
                     already stored in the connection profile for the target
                     host, frodo uses that profile's stored password instead of
                     requiring it on the command line.
  password           Password.

Options:
  --allow-failures   Report operations that fail, but still exit with code 0.
                     Without this option the command runs every operation,
                     prints a summary of what failed and exits with code 1.
  -d, --dry-run      Show which software publishers would be deleted without
                     deleting them.
  -n, --name <name>  Software publisher name (the name of the object). If
                     specified, deletes only that publisher, without asking.
                     Needs a single realm.
  -y, --yes          Do not ask for confirmation before deleting more than one
                     software publisher (no -n). Required without a terminal.
  -h, --help         Help
  -hh, --help-more   Help with all options.
  -hhh, --help-all   Help with all options, environment variables, and usage
                     examples.
"
`;
