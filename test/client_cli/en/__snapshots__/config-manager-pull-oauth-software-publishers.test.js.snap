// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'config-manager pull oauth-software-publishers' should be expected english 1`] = `
"Usage: frodo config-manager pull oauth-software-publishers [options] [host] [realm] [username] [password]

[Experimental] Export the OAuth2 software publishers (the publishers whose
signed software statements an OAuth 2.0 provider accepts when a client registers
itself dynamically) of all realms or of one realm to
realms/<realm>/realm-config/agents/SoftwarePublisher/<name>.json, one file for
each. The file is the one that "pull oauth2-agents" wrote for the same
publisher, at the same path. A key set that holds a private or secret key is not
written: the file has \${<ID>_JWKSET} in its place (the id of the object in upper
case) and a warning says so. A realm that does not offer the agent type has
nothing to export. Software publishers are dynamic configuration: they are part
of "pull all" and not of "pull all-static".

Arguments:
  host                  AM base URL, e.g.: https://cdk.iam.example.com/am. To
                        use a connection profile, just specify a unique
                        substring or alias.
  realm                 Realm. Specify realm as '/' for the root realm or
                        'realm' or '/parent/child' otherwise. (default: "alpha"
                        for Identity Cloud tenants, "/" otherwise.)
  username              Username to login with. Must be an admin user with
                        appropriate rights to manage authentication
                        journeys/trees. If given without a password, and it
                        matches the username already stored in the connection
                        profile for the target host, frodo uses that profile's
                        stored password instead of requiring it on the command
                        line.
  password              Password.

Options:
  --allow-failures      Report operations that fail, but still exit with code 0.
                        Without this option the command runs every operation,
                        prints a summary of what failed and exits with code 1.
  --config-file <file>  A JSON file with overrides for values that differ
                        between environments, e.g.
                        "oauth-software-publishers.json".
  -n, --name <name>     Software publisher name, the name of the object. If
                        specified, pulls only that publisher. Needs a single
                        realm.
  -h, --help            Help
  -hh, --help-more      Help with all options.
  -hhh, --help-all      Help with all options, environment variables, and usage
                        examples.
"
`;
