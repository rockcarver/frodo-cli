// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'app' should be expected english 1`] = `
"Usage: frodo promote [options] [host] [realm] [username] [password]

Prepares a tenant to be promoted

Arguments:
  host                                AM base URL, e.g.:
                                      https://cdk.iam.example.com/am. To use a
                                      connection profile, just specify a unique
                                      substring or alias.
  realm                               Realm. Specify realm as '/' for the root
                                      realm or 'realm' or '/parent/child'
                                      otherwise. (default: "alpha" for Identity
                                      Cloud tenants, "/" otherwise.)
  username                            Username to login with. Must be an admin
                                      user with appropriate rights to manage
                                      authentication journeys/trees. If given
                                      without a password, and it matches the
                                      username already stored in the connection
                                      profile for the target host, frodo uses
                                      that profile's stored password instead of
                                      requiring it on the command line.
  password                            Password.

Options:
  --allow-failures                    Report operations that fail, but still
                                      exit with code 0. Without this option the
                                      command runs every operation, prints a
                                      summary of what failed and exits with code
                                      1.
  -e, --frodo-export-dir <directory>  The directory where the frodo export is
                                      located.
  -M, --master-dir <directory>        The directory where the master
                                      configurations is located.
  --no-prune                          Do not prune orphaned nodes after a
                                      journey was deleted, and do not ask.
                                      Without this option, and without -y/--yes,
                                      the prune asks on a terminal and is
                                      refused when there is no terminal.
  --no-validate                       Do not validate journeys during promotion.
  -P --print-diff                     Outputs the diff to a file in the
                                      directory where the command was run.
                                      (default: false)
  --prompt-prune                      Ask before the orphaned nodes are pruned
                                      (permanently deleted) after a journey was
                                      deleted. This is what happens on a
                                      terminal without this option; without a
                                      terminal nothing can be asked and the
                                      prune is refused unless -y/--yes is given.
                                      The prune covers every orphaned node of
                                      the realm, not only those of the deleted
                                      journey. (default: false)
  -S --effect-secrets                 Will effect the secrets, otherwise we will
                                      not change the secrets but will compare
                                      them (default: false)
  --target <host url>                 Host URL of the environment to perform
                                      secret value encryption. The URL must
                                      resolve to an existing connection profile.
                                      Use this option to generate an export that
                                      can be imported into the target
                                      environment without requiring admin access
                                      to the source environment.
  -W --wait-secrets                   When secrets are effected we need to run a
                                      refresh on the enviornment. This will
                                      cause the command to wait until the
                                      refresh is finished. (default: false)
  --what-if                           Runs a what if of the comparison, so it
                                      wont do any changes (default: false)
  -y, --yes                           Do not ask before the orphaned nodes are
                                      pruned (permanently deleted) after a
                                      journey was deleted. Required for the
                                      prune when there is no terminal. The prune
                                      covers every orphaned node of the realm,
                                      not only those of the deleted journey.
  -h, --help                          Help
  -hh, --help-more                    Help with all options.
  -hhh, --help-all                    Help with all options, environment
                                      variables, and usage examples.
"
`;
