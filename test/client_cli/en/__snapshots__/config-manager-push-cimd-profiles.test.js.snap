// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'config-manager push cimd-profiles' should be expected english 1`] = `
"Usage: frodo config-manager push cimd-profiles [options] [host] [realm] [username] [password]

[Experimental] Import CIMD profiles from the files
realms/<realm>/realm-config/agents/CIMDProfile/<name>.json that "pull
cimd-profiles" writes, from the working directory (-D). A profile that does not
exist is created and one that does is replaced by exactly what the file holds:
what the file leaves out is removed. \${NAME} in a file is replaced by the value
of the environment variable NAME. No profile is ever deleted. The scripts and
journeys that a profile names must exist already, so push those first. A realm
or a deployment that does not offer CIMD profiles is skipped with a warning.

Arguments:
  host               AM base URL, e.g.: https://cdk.iam.example.com/am. To use a
                     connection profile, just specify a unique substring or
                     alias.
  realm              Realm. Specify realm as '/' for the root realm or 'realm'
                     or '/parent/child' otherwise. (default: "alpha" for
                     Identity Cloud tenants, "/" otherwise.)
  username           Username to login with. Must be an admin user with
                     appropriate rights to manage authentication journeys/trees.
                     If given without a password, and it matches the username
                     already stored in the connection profile for the target
                     host, frodo uses that profile's stored password instead of
                     requiring it on the command line.
  password           Password.

Options:
  --allow-failures   Report operations that fail, but still exit with code 0.
                     Without this option the command runs every operation,
                     prints a summary of what failed and exits with code 1.
  -n, --name <name>  CIMD profile name. If specified, pushes only the profile of
                     the file with that name. Needs a single realm.
  -h, --help         Help
  -hh, --help-more   Help with all options.
  -hhh, --help-all   Help with all options, environment variables, and usage
                     examples.
"
`;
