exports[`CLI help interface for 'conn' should be expected english 1`] = `
"Usage: frodo conn [options] [command] [host]

Manage connection profiles.

Run without a sub-command to interactively set a profile's preferred credential.

Arguments:
  host              AM base URL, e.g.: https://cdk.iam.example.com/am. To use a
                    connection profile, just specify a unique substring or
                    alias.

Options:
  -h, --help        Help
  -hh, --help-more  Help with all options.
  -hhh, --help-all  Help with all options, environment variables, and usage
                    examples.

Commands:
  alias             Manage connection aliases.
  delete            Delete connection profiles.
  describe          Describe connection profile.
  list              List connection profiles.
  save|add          Save connection profiles.
  service-account   Manage named, independently-addressable additional service
                    accounts on a connection profile (alongside its own single
                    primary service account).
  set               Set fields of an existing connection profile. Only the
                    fields given on the command line change; everything else
                    stays as-is. Run 'frodo conn set' without any field option
                    to list the settable fields.
  test              Test connection and authentication.
"
`;
