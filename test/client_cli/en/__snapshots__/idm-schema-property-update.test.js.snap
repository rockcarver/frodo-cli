// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'idm schema property update' should be expected english 1`] = `
"Usage: frodo idm schema property update [options] [host] [realm] [username] [password]

Update IDM managed object property schema definition.

Arguments:
  host                               AM base URL, e.g.:
                                     https://cdk.iam.example.com/am. To use a
                                     connection profile, just specify a unique
                                     substring or alias.
  realm                              Realm. Specify realm as '/' for the root
                                     realm or 'realm' or '/parent/child'
                                     otherwise. (default: "alpha" for Identity
                                     Cloud tenants, "/" otherwise.)
  username                           Username to login with. Must be an admin
                                     user with appropriate rights to manage
                                     authentication journeys/trees. If given
                                     without a password, and it matches the
                                     username already stored in the connection
                                     profile for the target host, frodo uses
                                     that profile's stored password instead of
                                     requiring it on the command line.
  password                           Password.

Options:
  --array                            Change to an array of --property-type.
  --default <value>                  Change the default value. Parsed as JSON
                                     when possible (e.g. "5" becomes the number
                                     5, "true" the boolean true), otherwise used
                                     as a literal string.
  --derive-fields <csv>              Change the comma-separated list of fields
                                     pulled from each referenced object.
                                     Requires --derive-from-relationship (on
                                     this call, or already configured).
  --derive-from-relationship <name>  Change this to a relationship-derived
                                     virtual property (RDVP): compute its value
                                     by querying through this relationship
                                     property. E.g. "memberOfOrg".
  --description <text>               Change the property description.
  --enum <csv>                       Change the comma-separated list of allowed
                                     values.
  --enum-titles <csv>                Change the comma-separated list of display
                                     labels for --enum, in the same order.
                                     Requires --enum.
  --flatten                          Flatten --derive-fields values from a
                                     to-many relationship into a single array.
                                     Requires --derive-from-relationship (on
                                     this call, or already configured).
  --not-viewable                     Hide this property in the UI.
  -o, --managed-object <type>        Managed object type. (prompts if missing)
  --on-retrieve-script <file>        Change this to a script-derived virtual
                                     property: compute its value on read from
                                     this local JavaScript file. Doesn't affect
                                     an existing --on-store-script.
  --on-store-script <file>           Compute this property's stored value on
                                     write from this local JavaScript file.
                                     Doesn't affect an existing
                                     --on-retrieve-script.
  -p, --property <name>              Property name. (prompts if missing)
  --property-type <type>             Change the property type. Valid types:
                                     string, number, boolean, date, time,
                                     datetime, duration, object. (choices:
                                     "string", "number", "boolean", "date",
                                     "time", "datetime", "duration", "object")
  --required                         Require a value for this property.
  --return-by-default                Return this property by default on reads.
  --searchable                       Mark the property searchable in the UI.
  --sub-property <path>              Update a nested property, as a dot-path
                                     relative to -p. Requires every level but
                                     the last to already exist and be of type
                                     "object".
  --title <text>                     Change the display title.
  --user-editable                    Allow end users to edit this property.
  -y, --yes                          Answer y/yes to all prompts.
  -h, --help                         Help
  -hh, --help-more                   Help with all options.
  -hhh, --help-all                   Help with all options, environment
                                     variables, and usage examples.
"
`;
