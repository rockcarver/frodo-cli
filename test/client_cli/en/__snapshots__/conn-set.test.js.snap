// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'conn set' should be expected english 1`] = `
"Usage: frodo conn set [options] [host] [username] [password]

Set fields of an existing connection profile. Only the fields given on the
command line change; everything else stays as-is. Run 'frodo conn set' without
any field option to list the settable fields.

Arguments:
  host                                         AM base URL, e.g.: https://cdk.iam.example.com/am. To use a connection profile, just specify a unique substring or alias.
  username                                     Username to login with. Must be an admin user with appropriate rights to manage authentication journeys/trees. If given without a password, and it matches the username already stored in the connection profile for the target host, frodo uses that profile's stored password instead of requiring it on the command line.
  password                                     Password.

Options:
  --alias [name]                               Alias name for this connection profile.
  --allow-insecure                             Allow insecure connections when using SSL/TLS (persisted on the profile).
  --authentication-header-overrides [headers]  Map of headers: '{"host":"am.example.com:8081"}'. These headers are sent with all requests.
  --authentication-service [service]           Name of the authentication service/tree to use.
  --configuration-header-overrides [headers]   Map of headers: '{"X-Configuration-Type":"mutable"}'. These headers are sent with all configuration requests.
  --log-api-key [key]                          Log API key.
  --log-api-secret [secret]                    Log API secret.
  --no-preferred-device-flow                   Explicitly persist a preference against device flow (loopback-redirect instead).
  --no-validate                                Do not validate the connection after setting the fields.
  --password [password]                        Password for the username. Given without a value, reads it from stdin non-interactively (echo off) when piped; prompts securely on an interactive terminal.
  --preferred-device-flow                      Persist a preference for the OAuth2 Device Authorization Grant over the default loopback-redirect flow (only meaningful with --preferred-credential browser).
  --username [username]                        Username to login with.
  -h, --help                                   Help
  -hh, --help-more                             Help with all options.
  -hhh, --help-all                             Help with all options, environment variables, and usage examples.
"
`;
