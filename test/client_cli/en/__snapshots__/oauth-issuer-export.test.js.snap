// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'oauth issuer export' should be expected english 1`] = `
"Usage: frodo oauth issuer export [options] [host] [realm] [username] [password]

Export OAuth2 trusted JWT issuers.

Arguments:
  host                         AM base URL, e.g.:
                               https://cdk.iam.example.com/am. To use a
                               connection profile, just specify a unique
                               substring or alias.
  realm                        Realm. Specify realm as '/' for the root realm or
                               'realm' or '/parent/child' otherwise. (default:
                               "alpha" for Identity Cloud tenants, "/"
                               otherwise.)
  username                     Username to login with. Must be an admin user
                               with appropriate rights to manage authentication
                               journeys/trees. If given without a password, and
                               it matches the username already stored in the
                               connection profile for the target host, frodo
                               uses that profile's stored password instead of
                               requiring it on the command line.
  password                     Password.

Options:
  -a, --all                    Export all trusted issuers to a single file.
                               Cannot be used with -i or -A.
  -A, --all-separate           Export all trusted issuers to separate files
                               (*.oauth2.issuer.json) in the current directory.
                               Cannot be used with -i, -f or -a.
  --allow-failures             Report operations that fail, but still exit with
                               code 0. Without this option the command runs
                               every operation, prints a summary of what failed
                               and exits with code 1.
  -f, --file <file>            Name of the export file. Defaults to
                               <id>.oauth2.issuer.json for an issuer and
                               allAlphaIssuers.oauth2.issuer.json for -a (the
                               realm in its name). Cannot be used with -A.
  -i, --issuer-id <issuer-id>  Trusted issuer id: the name of the object in the
                               realm, not the issuer URL (iss) that its
                               assertions carry. Cannot be used with -a or -A.
                               (pick from trusted JWT issuer)
  -N, --no-metadata            Does not include metadata in the export file.
  -h, --help                   Help
  -hh, --help-more             Help with all options.
  -hhh, --help-all             Help with all options, environment variables, and
                               usage examples.

Rule:
  one of -i, --issuer-id <issuer-id> | -a, --all | -A, --all-separate is required -- choose what to export

"
`;
