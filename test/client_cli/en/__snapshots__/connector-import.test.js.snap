// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'connector import' should be expected english 1`] = `
"Usage: frodo connector import [options] [host] [realm] [username] [password]

Import IDM connectors.

Arguments:
  host                     AM base URL, e.g.: https://cdk.iam.example.com/am. To
                           use a connection profile, just specify a unique
                           substring or alias.
  realm                    Realm. Specify realm as '/' for the root realm or
                           'realm' or '/parent/child' otherwise. (default:
                           "alpha" for Identity Cloud tenants, "/" otherwise.)
  username                 Username to login with. Must be an admin user with
                           appropriate rights to manage authentication
                           journeys/trees. If given without a password, and it
                           matches the username already stored in the connection
                           profile for the target host, frodo uses that
                           profile's stored password instead of requiring it on
                           the command line.
  password                 Password.

Options:
  -a, --all                Import all connectors from the file given with -f.
                           Cannot be used with -i or -A.
  -A, --all-separate       Import all connectors from separate files
                           (*.connector.idm.json) in the current directory.
                           Cannot be used with -i, -f or -a.
  --allow-failures         Report operations that fail, but still exit with code
                           0. Without this option the command runs every
                           operation, prints a summary of what failed and exits
                           with code 1.
  -f, --file <file>        Name of the import file. Without -i or -a the first
                           connector of the file is imported. Cannot be used
                           with -A.
  -i, --connector-id <id>  Connector id: import this one from the file given
                           with -f. Cannot be used with -a or -A.
  --no-deps                Do not import the mappings of the file with the
                           connector. Only with -i or when the first connector
                           is imported: importing all connectors never imports
                           mappings.
  -h, --help               Help
  -hh, --help-more         Help with all options.
  -hhh, --help-all         Help with all options, environment variables, and
                           usage examples.

Rule:
  one of -f, --file <file> | -A, --all-separate is required -- choose what to import

"
`;
