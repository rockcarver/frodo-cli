exports[`CLI help interface for 'settings theme autodetect' should be expected english 1`] = `
"Usage: frodo settings theme autodetect [options] [state]

Enable or disable one-time terminal-background auto-detection on first run. Run
with no argument to show the current setting.

Arguments:
  state             Either "on" or "off".

Options:
  -h, --help        Help
  -hh, --help-more  Help with all options.
  -hhh, --help-all  Help with all options, environment variables, and usage
                    examples.
"
`;

exports[`CLI help interface for 'settings theme background' should be expected english 1`] = `
"Usage: frodo settings theme background [options] <name>

Set the background color preference (your contrast preference is unaffected).

Arguments:
  name              Background to use. One of: dark, light, blue, yellow.

Options:
  -h, --help        Help
  -hh, --help-more  Help with all options.
  -hhh, --help-all  Help with all options, environment variables, and usage
                    examples.
"
`;

exports[`CLI help interface for 'settings theme contrast' should be expected english 1`] = `
"Usage: frodo settings theme contrast [options] <tier>

Set the contrast preference (your background preference is unaffected).
"vibrant" is the default -- the most colorful option each background supports;
"high-contrast" always clears strict WCAG AA.

Arguments:
  tier              Contrast level to use. One of: high-contrast, regular,
                    vibrant.

Options:
  -h, --help        Help
  -hh, --help-more  Help with all options.
  -hhh, --help-all  Help with all options, environment variables, and usage
                    examples.
"
`;

exports[`CLI help interface for 'settings theme detect' should be expected english 1`] = `
"Usage: frodo settings theme detect [options]

Detect this terminal's actual background color and set it as your background
preference (your contrast preference is unaffected). Run this again any time
you've switched terminals or changed your terminal's colors -- detection
otherwise only ever runs automatically once, the first time no background has
been chosen yet.

Options:
  -h, --help        Help
  -hh, --help-more  Help with all options.
  -hhh, --help-all  Help with all options, environment variables, and usage
                    examples.
"
`;

