// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'connector export' should be expected english 1`] = `
"Usage: frodo connector export [options] [host] [realm] [username] [password]

Export IDM connectors.

Arguments:
  host                     AM base URL, e.g.: https://cdk.iam.example.com/am. To
                           use a connection profile, just specify a unique
                           substring or alias.
  realm                    Realm. Specify realm as '/' for the root realm or
                           'realm' or '/parent/child' otherwise. (default:
                           "alpha" for Identity Cloud tenants, "/" otherwise.)
  username                 Username to login with. Must be an admin user with
                           appropriate rights to manage authentication
                           journeys/trees. If given without a password, and it
                           matches the username already stored in the connection
                           profile for the target host, frodo uses that
                           profile's stored password instead of requiring it on
                           the command line.
  password                 Password.

Options:
  -a, --all                Export all connectors to a single file. Cannot be
                           used with -i or -A.
  -A, --all-separate       Export all connectors as separate files
                           <id>.connector.idm.json. Cannot be used with -i, -f
                           or -a.
  --allow-failures         Report operations that fail, but still exit with code
                           0. Without this option the command runs every
                           operation, prints a summary of what failed and exits
                           with code 1.
  -f, --file <file>        Name of the export file. Defaults to
                           <id>.connector.idm.json for a connector and
                           allConnectors.connector.idm.json for -a. Cannot be
                           used with -A.
  -i, --connector-id <id>  Connector id: the name of the connector configuration
                           without the provisioner.openicf/ prefix. Cannot be
                           used with -a or -A. (pick from connector)
  -N, --no-metadata        Does not include metadata in the export file.
  --no-deps                Do not include the mappings of the connector in the
                           export. Only with -i: the export of all connectors
                           never includes mappings.
  -h, --help               Help
  -hh, --help-more         Help with all options.
  -hhh, --help-all         Help with all options, environment variables, and
                           usage examples.

Rule:
  one of -a, --all | -A, --all-separate | -i, --connector-id <id> is required -- choose what to export

"
`;
