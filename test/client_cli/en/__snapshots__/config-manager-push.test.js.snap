// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'config push' should be expected english 1`] = `
"Usage: frodo config push [options] [command]

[Experimental] Import configuration optimized for CI/CD pipelines (format
compatible with fr-config-manager).

Options:
  -h, --help                 Help
  -hh, --help-more           Help with all options.
  -hhh, --help-all           Help with all options, environment variables, and
                             usage examples.

Runtime Options:
  --no-prompt                Never prompt interactively (same as setting
                             FRODO_NO_PROMPT).

Commands:
  access-config              [Experimental] Import access configuration.
  agents                     [Experimental] Import agents from the files written
                             by pull.
  all-static                 [Experimental] Import all static configuration.
  apps                       [Experimental] Import applications, one folder per
                             application with the objects it owns. (formerly:
                             applications)
  audit                      [Experimental] Import audit configuration.
  authn                      [Experimental] Import authentication objects.
                             (formerly: authentication)
  authz-policies             [Experimental] Import authorization policies.
  config-metadata            [Experimental] Import metadata.
  connector-mappings         [Experimental] Import connector mappings.
  connector-servers          [Experimental] Import RCS config. (formerly:
                             remote-servers)
  connectors                 [Experimental] Import connector definitions.
                             (formerly: connector-definitions)
  cookie-domains             [Experimental] [Cloud-only] Import cookie domains.
  cors                       [Experimental] Import CORS configuration.
  csp                        [Experimental] [Cloud-only] Import content security
                             policy.
  email-provider             [Experimental] Import email provider configuration.
  email-templates            [Experimental] Import email template objects.
  endpoints                  [Experimental] Import custom endpoints objects.
  idm-authentication         [Experimental] Import idm authentication.
  iga-workflows              [Experimental] [Cloud-only] Import iga-workflows.
  internal-roles             [Experimental] Import internal roles.
  journeys                   [Experimental] Import journeys.
  kba                        [Experimental] Import kba configuration.
  locales                    [Experimental] Import custom locales objects.
  managed-objects            [Experimental] Import managed objects and their
                             custom relationship schemas.
  nodes                      [Experimental] Import custom nodes. (formerly:
                             custom-nodes)
  oauth-cimd-profiles        [Experimental] Import CIMD profiles from the files
                             written by pull.
  oauth-clients              [Experimental] Import OAuth2 clients from the files
                             written by pull.
  oauth-issuers              [Experimental] Import trusted JWT issuers from the
                             files written by pull.
  oauth-software-publishers  [Experimental] Import software publishers from the
                             files written by pull.
  oauth2-agents              [Deprecated] Deprecated: pushes what "push
                             oauth-clients" and "push agents" push together.
  org-privileges             [Experimental] Import organization privileges
                             config.
  password-policy            [Experimental] Import password-policy objects.
  raw                        [Experimental] Import raw configurations.
  remote-proxies             [Experimental] [Cloud-only] Import IDM remote
                             proxies from the files remote-proxies/<name>.json.
  restart                    [Experimental] [Cloud-only] Restart the
                             environment.
  saml                       [Experimental] Import saml configuration.
  schedules                  [Experimental] Import schedules.
  scripts                    [Experimental] Import scripts.
  secrets                    [Experimental] [Cloud-only] Import secrets.
  secretstore-mappings       [Experimental] [Cloud-only] Import secret mappings.
                             (formerly: secret-mappings)
  service-objects            [Experimental] Import service objects.
  services                   [Experimental] Import AM authentication services.
  telemetry                  [Experimental] [Cloud-only] Import telemetry
                             exporters.
  terms-and-conditions       [Experimental] Import terms and conditions.
  themes                     [Experimental] Import themes.
  ui-config                  [Experimental] Import UI configuration.
  variables                  [Experimental] [Cloud-only] Import variables.

Utilities:
  help                       display help for command


Run without a sub-command to enter interactive mode."
`;
