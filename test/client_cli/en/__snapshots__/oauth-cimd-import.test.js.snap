// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CLI help interface for 'oauth cimd import' should be expected english 1`] = `
"Usage: frodo oauth cimd import [options] [host] [realm] [username] [password]

Import CIMD profiles.

Arguments:
  host                           AM base URL, e.g.:
                                 https://cdk.iam.example.com/am. To use a
                                 connection profile, just specify a unique
                                 substring or alias.
  realm                          Realm. Specify realm as '/' for the root realm
                                 or 'realm' or '/parent/child' otherwise.
                                 (default: "alpha" for Identity Cloud tenants,
                                 "/" otherwise.)
  username                       Username to login with. Must be an admin user
                                 with appropriate rights to manage
                                 authentication journeys/trees. If given without
                                 a password, and it matches the username already
                                 stored in the connection profile for the target
                                 host, frodo uses that profile's stored password
                                 instead of requiring it on the command line.
  password                       Password.

Options:
  -a, --all                      Import all CIMD profiles from the file given
                                 with -f. Cannot be used with -i or -A.
  -A, --all-separate             Import all CIMD profiles from separate files
                                 (*.oauth2.cimd.json) in the current directory.
                                 Cannot be used with -i, -f or -a.
  --allow-failures               Report operations that fail, but still exit
                                 with code 0. Without this option the command
                                 runs every operation, prints a summary of what
                                 failed and exits with code 1.
  -f, --file <file>              Name of the import file. Without -i or -a the
                                 first profile of the file is imported. Cannot
                                 be used with -A.
  -i, --profile-id <profile-id>  Profile id: import this CIMD profile from the
                                 file given with -f. Cannot be used with -a or
                                 -A.
  -h, --help                     Help
  -hh, --help-more               Help with all options.
  -hhh, --help-all               Help with all options, environment variables,
                                 and usage examples.

Rule:
  one of -f, --file <file> | -A, --all-separate is required -- choose what to import

"
`;
