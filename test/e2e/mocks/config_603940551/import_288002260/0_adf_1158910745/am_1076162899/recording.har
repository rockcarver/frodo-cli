            "text": "{\"_id\":\"c5a8d1b2e4f06a9b3c5d7e8f1a2b3c4d-1\",\"description\":\"Face biometric enrollment via PingOne Recognize WebSDK.\",\"displayName\":\"PingOne Recognize Biometric Web Enrollment\",\"errorOutcome\":false,\"inputs\":[],\"outcomes\":[\"success\",\"retry\",\"error\",\"alreadyEnrolled\"],\"outputs\":[],\"properties\":{\"apiKey\":{\"description\":\"API Key generated in the P1Recognize tenant under Access Control. Supports ESV references using dot notation e.g. esv.p1recognize.apikey\",\"multivalued\":false,\"required\":true,\"title\":\"API Key\",\"type\":\"STRING\"},\"enableCameraInstructions\":{\"defaultValue\":true,\"description\":\"Show camera instruction steps before biometric capture begins\",\"multivalued\":false,\"required\":false,\"title\":\"Enable Camera Instructions\",\"type\":\"BOOLEAN\"},\"errorSubmitDelay\":{\"defaultValue\":3000,\"description\":\"Milliseconds to wait after a biometric error before submitting. Default 3000. Set to 0 to submit immediately.\",\"multivalued\":false,\"required\":false,\"title\":\"Error Submit Delay (ms)\",\"type\":\"NUMBER\"},\"finishedSubmitDelay\":{\"defaultValue\":3000,\"description\":\"Milliseconds to wait after a successful biometric before submitting. Default 3000. Set to 0 to submit immediately.\",\"multivalued\":false,\"required\":false,\"title\":\"Finished Submit Delay (ms)\",\"type\":\"NUMBER\"},\"hidePoweredBy\":{\"defaultValue\":true,\"description\":\"Hides the PoweredBy footer displayed on all screens.\",\"multivalued\":false,\"required\":false,\"title\":\"Hide Powered By Keyless\",\"type\":\"BOOLEAN\"},\"publicKey\":{\"description\":\"The public key used as part of the image encryption process. The publicKey is available via an HTTP GET to the {{baseURL}}/v1/customers/{{tenant_name}}}/image-encryption endpoint. Remove all \\\\n newline characters and the -----BEGIN PUBLIC KEY----- and -----END PUBLIC KEY----- tags from the publicKey before using it in the node configuration. \",\"multivalued\":false,\"required\":true,\"title\":\"Public Key\",\"type\":\"STRING\"},\"publicKeyId\":{\"description\":\"The ID of the public key used as part of the image encryption process. The keyID is available via an HTTP GET to the {{baseURL}}/v1/customers/{{tenant_name}}}/image-encryption endpoint.\",\"multivalued\":false,\"required\":true,\"title\":\"Public Key ID\",\"type\":\"STRING\"},\"sdkLanguage\":{\"description\":\"Explicit language override. If set, takes precedence over auto-detection. Leave blank for auto-detection. (e.g. en, fr, de)\",\"multivalued\":false,\"required\":false,\"title\":\"SDK Language (override)\",\"type\":\"STRING\"},\"sdkLocalization\":{\"description\":\"JSON to enable customization and localisation of text displayed by P1Recognize UI.  Multiple language tags are supported. e.g. [\\n  {\\\"language\\\":\\\"en\\\",\\\"steps\\\":{\\\"camera-instructions\\\":{\\\"headline\\\":\\\"...\\\",\\\"text\\\":\\\"...\\\"}}},\\n  {\\\"language\\\":\\\"fr\\\",\\\"steps\\\":{\\\"camera-instructions\\\":{\\\"headline\\\":\\\"...\\\",\\\"text\\\":\\\"...\\\"}}}\\n]\",\"multivalued\":false,\"required\":false,\"title\":\"SDK Localization\",\"type\":\"STRING\"},\"sdkTheme\":{\"defaultValue\":\"LIGHT\",\"description\":\"The Web SDK supports both light and dark themes.\",\"multivalued\":false,\"options\":{\"DARK\":\"dark\",\"LIGHT\":\"light\"},\"required\":true,\"title\":\"SDK Theme\",\"type\":\"STRING\"},\"sdkThemeOptions\":{\"description\":\"JSON to align to UX theme option changes. e.g. {\\\"colors\\\":{\\\"light\\\":{\\\"primary\\\":\\\"#1E69D2\\\",\\\"onPrimary\\\":\\\"#fff\\\",\\\"surface\\\":\\\"#fff\\\",\\\"onSurface\\\":\\\"#000\\\"}}}).  \",\"multivalued\":false,\"required\":false,\"title\":\"SDK Theme Options\",\"type\":\"STRING\"},\"tenantEnvironment\":{\"defaultValue\":\"US\",\"description\":\"The regional location of the provisioned P1Recognize tenant.\",\"multivalued\":false,\"options\":{\"EUROPE\":\"EUROPE\",\"LATAM\":\"LATAM\",\"SANDBOX\":\"SANDBOX\",\"US\":\"US\"},\"required\":true,\"title\":\"P1 Recognize Tenant Region\",\"type\":\"STRING\"},\"tenantName\":{\"description\":\"The P1Recognize tenant name, shown as customer name within the P1Recognize tenant.\",\"multivalued\":false,\"required\":true,\"title\":\"P1 Recognize Tenant Name\",\"type\":\"STRING\"},\"webSdkVersion\":{\"defaultValue\":\"2.3.0\",\"description\":\"Version of the P1Recognize Web SDK. Default is 2.3.0.\",\"multivalued\":false,\"required\":true,\"title\":\"Web SDK Version\",\"type\":\"STRING\"}},\"script\":\"/**\\n * ============================================================\\n *  PINGONE RECOGNIZE BIOMETRIC ENROLLMENT\\n *  PingOne AIC — Custom Node (Node Designer)\\n * ============================================================\\n *\\n *  Import via:  Journeys → Node Designer → Import  (or REST API)\\n *\\n *  NODE PROPERTIES (configured in Node Designer):\\n *    • tenantEnvironment        — SANDBOX | US | EUROPE | LATAM\\n *    • tenantName               — P1 Recognize tenant/customer name\\n *    • apiKey                   — P1 Recognize API key (supports ESV dot notation e.g. esv.p1recognize.apikey)\\n *    • publicKeyId              — Image encryption key ID\\n *    • publicKey                — Image encryption public key\\n *    • webSdkVersion            — Web SDK version to load (e.g. 2.3.0)\\n *    • sdkTheme                 — light | dark  (default: light)\\n *    • sdkLanguage              — Language override code (e.g. en, fr, de);\\n *                                 auto-detected from locale param / Accept-Language if blank\\n *    • enableCameraInstructions — Show camera instruction steps before capture (Boolean)\\n *    • finishedSubmitDelay      — ms to wait after success before form submit (default: 3000)\\n *    • errorSubmitDelay         — ms to wait after error before form submit (default: 3000)\\n *    • hidePoweredBy            — Remove 'Powered by Keyless' branding (Boolean)\\n *    • sdkThemeOptions          — JSON object for SDK colour overrides\\n *    • sdkLocalization          — JSON array of localization packs\\n *\\n *  NODE OUTCOMES:\\n *    • success         — biometric enrollment completed; transaction JWT validated\\n *    • error           — enrollment or JWT verification failed\\n *    • retry           — user cancelled / camera error / connection error\\n *    • alreadyEnrolled — user already has a biometric enrollment on record\\n *\\n *  SHARED-STATE INPUTS (prior node, e.g. Platform Username):\\n *    • username\\n *\\n *  SHARED-STATE OUTPUTS (written on success):\\n *    • p1RTransactionJwt  — signed JWT from P1 Recognize\\n *    • p1REnrollStatus    — \\\"enrolled\\\" | \\\"failed\\\"\\n *\\n *  Required CSP additions (vary by tenantEnvironment):\\n *    script-src   https://d3hz8ozgrmhn4r.cloudfront.net\\n *    connect-src  <AUTH_URL for selected environment>\\n *\\n * Author(s):\\n *    Mike Simon (@mjspi)\\n * ============================================================\\n */\\n\\n//// CONSTANTS\\nvar SDK_CDN_BASE = \\\"https://d3hz8ozgrmhn4r.cloudfront.net/sdk-web-components\\\";\\n\\nvar ENV_CONFIGS = {\\n  \\\"SANDBOX\\\": {\\n    AUTH_URL: \\\"https://authentication-service-sandbox.eks.core-production.keyless.technology\\\",\\n    OPS_URL:  \\\"https://operations-service-sandbox.eks.core-production.keyless.technology\\\"\\n  },\\n  \\\"US\\\": {\\n    AUTH_URL: \\\"https://authentication-service.eks.core-production.saas-us-east.keyless.technology\\\",\\n    OPS_URL:  \\\"https://api.eks.core-production.saas-us-east.keyless.technology\\\"\\n  },\\n  \\\"EUROPE\\\": {\\n    AUTH_URL: \\\"https://authentication-service.eks.core-production.keyless.technology\\\",\\n    OPS_URL:  \\\"https://api.keyless.io\\\"\\n  },\\n  \\\"LATAM\\\": {\\n    AUTH_URL: \\\"https://authentication-service.eks.core-production.latam.keyless.technology\\\",\\n    OPS_URL:  \\\"https://api.eks.core-production.latam.keyless.technology\\\"\\n  }\\n};\\n\\n//// PARAMETERS\\nvar envKey    = String(properties.tenantEnvironment || \\\"US\\\");\\nvar envConfig = ENV_CONFIGS[envKey] || ENV_CONFIGS[\\\"US\\\"];\\n\\n// Read properties first so derived URLs can reference them\\nvar P1R_API_KEY    = String(properties.apiKey       || \\\"\\\");\\nvar P1R_KEY_ID     = String(properties.publicKeyId  || \\\"\\\");\\nvar P1R_PUBLIC_KEY = String(properties.publicKey    || \\\"\\\");\\nvar P1R_CUSTOMER   = String(properties.tenantName   || \\\"\\\");\\n\\n// Derive service URLs from environment config\\nvar P1R_WS_URL           = envConfig.AUTH_URL.replace(\\\"https://\\\", \\\"wss://\\\");\\nvar P1R_ENROLL_CHECK_URL = envConfig.AUTH_URL + \\\"/v1/users/\\\" + P1R_CUSTOMER + \\\"/\\\";\\nvar P1R_VERIFY_URL       = envConfig.OPS_URL  + \\\"/v2/verify-jwt\\\";\\n\\nvar SDK_HIDE_POWERED_BY  = (properties.hidePoweredBy === true);\\nvar SDK_THEME            = String(properties.sdkTheme || \\\"light\\\").trim().toLowerCase();\\n// Detect language: locale query param → Accept-Language header → sdkLanguage property\\nvar SDK_LANGUAGE = (function () {\\n  // Helper: extract base language code from a BCP-47 tag (e.g. \\\"en-US\\\" → \\\"en\\\")\\n  function baseLang(tag) {\\n    return String(tag).trim().split(/[-_]/)[0].toLowerCase();\\n  }\\n  // 1. sdkLanguage property — explicit override takes highest priority\\n  var configured = String(properties.sdkLanguage || \\\"\\\").trim();\\n  if (configured) { return configured; }\\n  // 2. locale query parameter — matches AIC hosted page behaviour\\n  try {\\n    var localeParam = requestParameters.get(\\\"locale\\\");\\n    if (localeParam && localeParam.get(0)) {\\n      var lang = baseLang(localeParam.get(0));\\n      if (lang) { return lang; }\\n    }\\n  } catch (e) { /* binding unavailable */ }\\n  // 3. Accept-Language request header\\n  // Format: \\\"en-US,en;q=0.9,fr;q=0.8\\\" — take the first tag before any comma or semicolon\\n  try {\\n    var acceptLang = requestHeaders.get(\\\"Accept-Language\\\");\\n    if (acceptLang && acceptLang.get(0)) {\\n      var primary = String(acceptLang.get(0)).split(\\\",\\\")[0].split(\\\";\\\")[0].trim();\\n      var lang = baseLang(primary);\\n      if (lang) { return lang; }\\n    }\\n  } catch (e) { /* binding unavailable */ }\\n  // 4. Default to English\\n  return \\\"en\\\";\\n})();\\nvar SDK_CAMERA_INSTRUCTIONS  = (properties.enableCameraInstructions === true);\\nvar SDK_THEME_OPTIONS   = String(properties.sdkThemeOptions || \\\"\\\").trim();\\nvar SDK_LOCALIZATION    = String(properties.sdkLocalization || \\\"\\\").trim();\\n\\n// Optional: data string P1Recognize signs alongside the auth transaction.\\n// Required for the transactionJWT to be returned in the finished event.\\n// Defaults to the username if not set.\\nvar P1R_TRANSACTION_DATA = (nodeState.get(\\\"transactionData\\\") || \\\"\\\");\\n\\n// ── Keyless SDK (version-pinned, SRI-verified) ────────────────\\nvar SDK_VERSION           = String(properties.webSdkVersion || \\\"2.3.0\\\");\\nvar SDK_BASE_URL          = SDK_CDN_BASE + \\\"/\\\" + SDK_VERSION;\\nvar SDK_MAIN_URL = SDK_BASE_URL + \\\"/index.js\\\";\\n\\n// ── Options ───────────────────────────────────────────────────\\nvar VERIFY_JWT_ENABLED       = (envKey !== \\\"SANDBOX\\\"); // Auto-disabled in Sandbox\\nvar FINISHED_SUBMIT_DELAY_MS = (properties.finishedSubmitDelay != null ? Number(properties.finishedSubmitDelay) : 3000);\\nvar ERROR_SUBMIT_DELAY_MS    = (properties.errorSubmitDelay    != null ? Number(properties.errorSubmitDelay)    : 3000);\\n\\n//// OUTCOMES\\nvar NODE_OUTCOME = { SUCCESS: \\\"success\\\", ERROR: \\\"error\\\", RETRY: \\\"retry\\\", ALREADY_ENROLLED: \\\"alreadyEnrolled\\\" };\\nvar RETRY_CODES = [\\\"CAMERA_PERMISSION_DENIED\\\", \\\"CAMERA_NOT_FOUND\\\", \\\"WEBSOCKET_CLOSED\\\", \\\"CONNECTION_ERROR\\\"];\\n\\n// ── Callback identifiers (must match order of nameCallback registration below)\\nvar CB_JWT_ID    = \\\"p1RTransactionJwt\\\";\\nvar CB_STATUS_ID = \\\"p1RStatus\\\";\\n\\n// ─────────────────────────────────────────────────────────────\\n//  buildClientScript  — generates the browser-side JS injected\\n//  via ScriptTextOutputCallback on the first pass.\\n// ─────────────────────────────────────────────────────────────\\nfunction buildClientScript(username) {\\n\\n  // Escape a value for safe embedding in a single-quoted JS string.\\n  // Handles backslashes, single quotes, and newlines (common in PEM keys).\\n  function esc(v) {\\n    return String(v)\\n      .replace(/\\\\\\\\/g,  \\\"\\\\\\\\\\\\\\\\\\\")\\n      .replace(/'/g,   \\\"\\\\\\\\'\\\")\\n      .replace(/\\\\r/g,  \\\"\\\\\\\\r\\\")\\n      .replace(/\\\\n/g, \\\"\\\\\\\\n\\\")\\n      // Use split/join for line-terminator chars — regex literals containing\\n      // \\\\u2028/\\\\u2029 become raw LineTerminators after JSON decode, causing\\n      // Rhino parse errors. split().join() avoids regex literal parsing entirely.\\n      .split(\\\"\\\\u0000\\\").join(\\\"\\\\\\\\0\\\")\\n      .split(\\\"\\\\u2028\\\").join(\\\"\\\\\\\\u2028\\\")\\n      .split(\\\"\\\\u2029\\\").join(\\\"\\\\\\\\u2029\\\");\\n  }\\n\\n  // Build structured transaction data object for auditing and traceability.\\n  // Embeds the AIC journey transaction ID alongside any clientData from state.\\n  var _h  = (typeof requestHeaders !== 'undefined') ? requestHeaders : null;\\n  var _id = (_h && _h.get('x-forgerock-transactionid')) ? _h.get('x-forgerock-transactionid').get(0) : \\\"no-tx-id\\\";\\n  var _txObj = { \\\"x-forgerock-transactionid\\\": _id };\\n  if (P1R_TRANSACTION_DATA) { _txObj[\\\"clientData\\\"] = P1R_TRANSACTION_DATA; }\\n  var txData = JSON.stringify(_txObj);\\n\\n  return [\\n    \\\"(function () {\\\",\\n    \\\"  'use strict';\\\",\\n    \\\"  function init() {\\\",\\n    \\\"    if (document.getElementById('kl-enroll-overlay')) { return; }\\\",\\n\\n    // Minimal style block — just the spinner keyframes\\n    \\\"    var klTheme = document.createElement('style');\\\",\\n    \\\"    klTheme.setAttribute('data-kl-enroll', '');\\\",\\n    \\\"    klTheme.textContent = '@keyframes klSpin{to{transform:rotate(360deg)}}';\\\",\\n    \\\"    document.head.appendChild(klTheme);\\\",\\n\\n    // 2. Inline wrapper — inserted into the callback container so the\\n    // Page Node's logo/title (rendered above the form) remain visible.\\n    \\\"    var overlay = document.createElement('div');\\\",\\n    \\\"    overlay.id = 'kl-enroll-overlay';\\\",\\n    \\\"    overlay.style.cssText = 'display:flex;justify-content:center;';\\\",\\n\\n    // Card\\n    \\\"    var card = document.createElement('div');\\\",\\n    \\\"    card.style.cssText = 'max-width:440px;width:100%;box-sizing:border-box;\\\" +\\n      \\\"display:flex;flex-direction:column;align-items:center;gap:20px';\\\",\\n\\n    // Status banner\\n    \\\"    var banner = document.createElement('div');\\\",\\n    \\\"    banner.style.cssText = 'display:none;font-size:13px;padding:10px 14px;\\\" +\\n      \\\"border-radius:8px;width:100%;text-align:center;box-sizing:border-box';\\\",\\n\\n    // Loading spinner — reuses @keyframes klSpin from klTheme style block above\\n    \\\"    var spinnerWrap = document.createElement('div');\\\",\\n    \\\"    spinnerWrap.id = 'kl-enroll-loading';\\\",\\n    \\\"    spinnerWrap.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:12px;padding:30px 0';\\\",\\n    \\\"    spinnerWrap.innerHTML = '<div style=\\\\\\\"width:40px;height:40px;border:4px solid #dde3f0;\\\" +\\n      \\\"border-top-color:#003CB4;border-radius:50%;animation:klSpin 0.8s linear infinite\\\\\\\"></div>\\\" +\\n      \\\"<span style=\\\\\\\"color:#888;font-size:13px\\\\\\\">Loading biometric module\\\\u2026</span>';\\\",\\n\\n    // kl-enroll component\\n    \\\"    var klEnroll = document.createElement('kl-enroll');\\\",\\n    \\\"    klEnroll.setAttribute('customer',                   '\\\" + esc(P1R_CUSTOMER)   + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('ws-url',                     '\\\" + esc(P1R_WS_URL)     + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('key-id',                     '\\\" + esc(P1R_KEY_ID)     + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('public-key',                 '\\\" + esc(P1R_PUBLIC_KEY) + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('username',                   '\\\" + esc(username)           + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('transaction-data',           '\\\" + esc(txData)             + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('lang',  '\\\" + esc(SDK_LANGUAGE) + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('size',  '320');\\\",\\n    \\\"    klEnroll.setAttribute('theme', '\\\" + esc(SDK_THEME)    + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('operation-id', '\\\" + esc(_id)   + \\\"');\\\",\\n    // \\\"    klEnroll.style.cssText = 'display:none;width:360px;border-radius:10px;overflow:hidden;margin:0 auto';\\\",\\n    \\\"    klEnroll.style.cssText = 'display:none;width:360px;max-width:360px;flex-shrink:0;border-radius:10px;overflow:hidden;margin:0 auto';\\\",\\n\\n    // ── Optional SDK customisations ─────────────────────────────\\n    \\\"    var _themeOpts = '\\\" + esc(SDK_THEME_OPTIONS) + \\\"';\\\",\\n    \\\"    if (_themeOpts) { try { klEnroll.themeOptions = JSON.parse(_themeOpts); } catch (e) {} }\\\",\\n    \\\"    var _locRaw = '\\\" + esc(SDK_LOCALIZATION) + \\\"';\\\",\\n    \\\"    if (_locRaw) {\\\",\\n    \\\"      try {\\\",\\n    \\\"        var _locEntries = JSON.parse(_locRaw);\\\",\\n    \\\"        var _locPacks = [];\\\",\\n    \\\"        for (var _i = 0; _i < _locEntries.length; _i++) {\\\",\\n    \\\"          var _e = _locEntries[_i];\\\",\\n    \\\"          _locPacks.push({ data: _e.data, language: _e.language });\\\",\\n    \\\"        }\\\",\\n    \\\"        klEnroll.localizationPacks = _locPacks;\\\",\\n    \\\"      } catch (e) {}\\\",\\n    \\\"    }\\\",\\n  ].concat(SDK_CAMERA_INSTRUCTIONS ? [\\n    \\\"    klEnroll.setAttribute('enable-camera-instructions', '');\\\",\\n  ] : []).concat(SDK_HIDE_POWERED_BY ? [\\n    \\\"    var _pb = document.createElement('span');\\\",\\n    \\\"    _pb.setAttribute('slot', 'powered-by');\\\",\\n    \\\"    klEnroll.appendChild(_pb);\\\",\\n  ] : []).concat([\\n\\n    // Cancel button\\n\\n    // Cancel button\\n    \\\"    var cancelBtn = document.createElement('button');\\\",\\n    \\\"    cancelBtn.textContent = 'Cancel';\\\",\\n    \\\"    cancelBtn.type = 'button';\\\",\\n    \\\"    cancelBtn.style.cssText = 'background:none;border:1px solid #003CB4;color:#003CB4;\\\" +\\n      \\\"padding:9px 24px;border-radius:6px;font-size:14px;cursor:pointer;margin-bottom:12px';\\\",\\n\\n    // Assemble\\n    \\\"    card.appendChild(banner);\\\",\\n    \\\"    card.appendChild(spinnerWrap);\\\",\\n    \\\"    card.appendChild(klEnroll);\\\",\\n    \\\"    card.appendChild(cancelBtn);\\\",\\n    \\\"    overlay.appendChild(card);\\\",\\n    \\\"    var klAnchor = document.querySelector('.fr-field, .callback, .form-group, .fr-center-card .card-body');\\\",\\n    \\\"    if (klAnchor) {\\\",\\n    \\\"      klAnchor.parentNode.insertBefore(overlay, klAnchor);\\\",\\n      \\\"      klAnchor.style.display = 'none';\\\",\\n    \\\"    } else {\\\",\\n    \\\"      document.body.appendChild(overlay);\\\",\\n    \\\"    }\\\",\\n\\n    // Callback slot discovery\\n    \\\"    var _allCbEls = document.querySelectorAll('input[name^=\\\\\\\"callback_\\\\\\\"]');\\\",\\n    \\\"    var _emptyCbs = [];\\\",\\n    \\\"    for (var _ci = 0; _ci < _allCbEls.length; _ci++) {\\\",\\n    \\\"      if (_allCbEls[_ci].value === '') { _emptyCbs.push(_allCbEls[_ci].name); }\\\",\\n    \\\"    }\\\",\\n    \\\"    var KL_CB_JWT    = _emptyCbs[_emptyCbs.length - 2] || 'callback_2';\\\",\\n    \\\"    var KL_CB_STATUS = _emptyCbs[_emptyCbs.length - 1] || 'callback_3';\\\",\\n\\n    // submitForm\\n    \\\"    function klSet(name, value) {\\\",\\n    \\\"      var el = document.querySelector('[name=\\\\\\\"' + name + '\\\\\\\"]');\\\",\\n    \\\"      if (!el) { return; }\\\",\\n    \\\"      var setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;\\\",\\n    \\\"      setter.call(el, value);\\\",\\n    \\\"      el.dispatchEvent(new Event('input',  { bubbles: true }));\\\",\\n    \\\"      el.dispatchEvent(new Event('change', { bubbles: true }));\\\",\\n    \\\"    }\\\",\\n    \\\"    var submitted = false;\\\",\\n    \\\"    function submitForm(jwt, status) {\\\",\\n    \\\"      if (submitted) { return; }\\\",\\n    \\\"      submitted = true;\\\",\\n    \\\"      klSet(KL_CB_JWT,    jwt    || '');\\\",\\n    \\\"      klSet(KL_CB_STATUS, status || '');\\\",\\n    \\\"      setTimeout(function () {\\\",\\n    \\\"        var btn = document.querySelector('button[type=submit],input[type=submit],#loginButton_0');\\\",\\n    \\\"        if (btn) { btn.click(); }\\\",\\n    \\\"      }, 300);\\\",\\n    \\\"      setTimeout(function () {\\\",\\n    \\\"        var el = document.getElementById('kl-enroll-overlay');\\\",\\n    \\\"        if (el && el.parentNode) { el.parentNode.removeChild(el); }\\\",\\n    \\\"        var th = document.querySelector('style[data-kl-enroll]');\\\",\\n    \\\"        if (th && th.parentNode) { th.parentNode.removeChild(th); }\\\",\\n    \\\"      }, 800);\\\",\\n    \\\"    }\\\",\\n\\n    // showBanner helper\\n    \\\"    function showBanner(msg, isSuccess) {\\\",\\n    \\\"      banner.textContent      = msg;\\\",\\n    \\\"      banner.style.background = isSuccess ? '#f0fff4' : '#fff0f0';\\\",\\n    \\\"      banner.style.color      = isSuccess ? '#27ae60' : '#c0392b';\\\",\\n    \\\"      banner.style.border     = isSuccess ? '1px solid #b2dfdb' : '1px solid #f5c6c6';\\\",\\n    \\\"      banner.style.display    = 'block';\\\",\\n    \\\"    }\\\",\\n\\n    // Button handler\\n\\n    // Button handler\\n    \\\"    cancelBtn.addEventListener('click', function () { submitForm('', 'cancelled'); });\\\",\\n\\n    // finished — biometric succeeded\\n    \\\"    var finishedFired = false;\\\",\\n    \\\"    klEnroll.addEventListener('finished', function (e) {\\\",\\n    \\\"      finishedFired = true;\\\",\\n    \\\"      var jwt = (e.detail || {}).transactionJWT || '';\\\",\\n    \\\"      showBanner('Enrollment successful! Redirecting\\\\u2026', true);\\\",\\n    \\\"      cancelBtn.disabled = true;\\\",\\n    \\\"      setTimeout(function () { submitForm(jwt, 'success'); }, \\\" + FINISHED_SUBMIT_DELAY_MS + \\\");\\\",\\n    \\\"    });\\\",\\n\\n    // error — biometric failed\\n    \\\"    var errorFired = false;\\\",\\n    \\\"    klEnroll.addEventListener('error', function (e) {\\\",\\n    \\\"      errorFired = true;\\\",\\n    \\\"      var d = e.detail || {};\\\",\\n    \\\"      showBanner(d.message || 'An error occurred during enrollment.', false);\\\",\\n    \\\"      setTimeout(function () { submitForm('', 'error:' + (d.code || 'UNKNOWN')); }, \\\" + ERROR_SUBMIT_DELAY_MS + \\\");\\\",\\n    \\\"    });\\\",\\n\\n    // close — only act if neither finished nor error already fired\\n    \\\"    klEnroll.addEventListener('close', function () {\\\",\\n    \\\"      if (finishedFired || errorFired) { return; }\\\",\\n    \\\"      submitForm('', 'cancelled');\\\",\\n    \\\"    });\\\",\\n\\n    // Load SDK — skip injection if custom element already registered (retry case)\\n    \\\"    if (typeof customElements !== 'undefined' && customElements.get('kl-enroll')) {\\\",\\n    \\\"      document.getElementById('kl-enroll-loading').style.display = 'none';\\\",\\n    \\\"      klEnroll.style.display = 'flex';\\\",\\n    \\\"    } else {\\\",\\n    \\\"      var sdk = document.createElement('script');\\\",\\n    \\\"      sdk.type    = 'module';\\\",\\n    \\\"      sdk.src     = '\\\" + esc(SDK_MAIN_URL) + \\\"';\\\",\\n    \\\"      sdk.onload  = function () {\\\",\\n    \\\"        document.getElementById('kl-enroll-loading').style.display = 'none';\\\",\\n    \\\"        klEnroll.style.display = 'flex';\\\",\\n    \\\"      };\\\",\\n    \\\"      sdk.onerror = function () {\\\",\\n    \\\"        showBanner('Failed to load the biometric module. Please refresh.', false);\\\",\\n    \\\"      };\\\",\\n    \\\"      document.head.appendChild(sdk);\\\",\\n    \\\"    }\\\",\\n    \\\"  }\\\",\\n\\n    \\\"  if (document.readyState === 'loading') {\\\",\\n    \\\"    document.addEventListener('DOMContentLoaded', init);\\\",\\n    \\\"  } else { init(); }\\\",\\n    \\\"}());\\\"\\n  ]).join(\\\"\\\\n\\\");\\n}\\n\\n//// UTILITIES\\n// ─────────────────────────────────────────────────────────────\\n//  maskUser — partial-mask a username for log output (PII hygiene)\\n// ─────────────────────────────────────────────────────────────\\nfunction maskUser(u) {\\n  var s = String(u || \\\"\\\");\\n  return s.length > 3 ? s.substring(0, 3) + \\\"***\\\" : \\\"***\\\";\\n}\\n\\n// ─────────────────────────────────────────────────────────────\\n//  checkEnrollmentStatus  — returns true if user is already enrolled\\n// ─────────────────────────────────────────────────────────────\\nfunction checkEnrollmentStatus(username) {\\n  try {\\n    var url      = P1R_ENROLL_CHECK_URL + encodeURIComponent(username);\\n    var response = httpClient.send(url, {\\n      method  : \\\"GET\\\",\\n      headers : { \\\"Kl-Api-Key\\\": P1R_API_KEY }\\n    }).get();\\n    if (response.status === 200) {\\n      var body = JSON.parse(response.text());\\n      return { success: true, isEnrolled: (body.isEnrolled === true) };\\n    }\\n    logger.error(\\\"[P1RecognizeEnroll] enrollment check HTTP \\\" + response.status + \\\" user=\\\" + maskUser(username));\\n    return { success: false };\\n  } catch (e) {\\n    logger.error(\\\"[P1RecognizeEnroll] enrollment check exception: \\\" + e);\\n    return { success: false };\\n  }\\n}\\n\\n// ─────────────────────────────────────────────────────────────\\n//  verifyTransactionJwt  — server-side JWT verification\\n// ─────────────────────────────────────────────────────────────\\nfunction verifyTransactionJwt(jwt) {\\n  try {\\n    var response = httpClient.send(P1R_VERIFY_URL, {\\n      method  : \\\"POST\\\",\\n      headers : { \\\"Content-Type\\\": \\\"application/json\\\", \\\"X-Api-Key\\\": P1R_API_KEY },\\n      body    : JSON.stringify({ message: jwt })\\n    }).get();\\n\\n    if (response.status === 200) {\\n      return { verified: true };\\n    }\\n    logger.error(\\\"[P1RecognizeEnroll] verify HTTP \\\" + response.status);\\n    return { verified: false, error: \\\"HTTP_\\\" + response.status };\\n  } catch (e) {\\n    logger.error(\\\"[P1RecognizeEnroll] verify exception: \\\" + e);\\n    return { verified: false, error: String(e) };\\n  }\\n}\\n\\n// ─────────────────────────────────────────────────────────────\\n//  outcomeForErrorCode\\n// ─────────────────────────────────────────────────────────────\\nfunction outcomeForErrorCode(code) {\\n  var i;\\n  for (i = 0; i < RETRY_CODES.length; i++) {\\n    if (RETRY_CODES[i] === code) { return NODE_OUTCOME.RETRY; }\\n  }\\n  return NODE_OUTCOME.ERROR;\\n}\\n\\n//// MAIN\\n// ─────────────────────────────────────────────────────────────\\n//  MAIN\\n// ─────────────────────────────────────────────────────────────\\n(function () {\\n\\n  // ── First pass: serve the biometric UI ─────────────────────\\n  if (callbacks.isEmpty()) {\\n    var username = nodeState.get(\\\"username\\\");\\n    if (!username) {\\n      logger.error(\\\"[P1RecognizeEnroll] 'username' not found in nodeState — ensure a Platform Username node precedes this node.\\\");\\n      action.goTo(NODE_OUTCOME.ERROR);\\n      return;\\n    }\\n    // Check if user is already enrolled before showing enrollment UI\\n    var enrollCheck = checkEnrollmentStatus(username);\\n    if (!enrollCheck.success) {\\n      logger.error(\\\"[P1RecognizeEnroll] could not verify enrollment status for user=\\\" + maskUser(username));\\n      action.goTo(NODE_OUTCOME.ERROR);\\n      return;\\n    }\\n    if (enrollCheck.isEnrolled) {\\n      logger.warn(\\\"[P1RecognizeEnroll] user already enrolled user=\\\" + maskUser(username));\\n      action.goTo(NODE_OUTCOME.ALREADY_ENROLLED);\\n      return;\\n    }\\n    callbacksBuilder.scriptTextOutputCallback(buildClientScript(username));\\n    callbacksBuilder.nameCallback(CB_JWT_ID);\\n    callbacksBuilder.nameCallback(CB_STATUS_ID);\\n    return;\\n  }\\n\\n  // ── Second pass: process the enrollment result ──────────────\\n  var username       = nodeState.get(\\\"username\\\");\\n  var cbs            = callbacks.getNameCallbacks();\\n  var returnedJwt    = String(cbs.get(0) || \\\"\\\");\\n  var returnedStatus = String(cbs.get(1) || \\\"\\\");\\n\\n  // Cancelled or timed out\\n  if (returnedStatus === \\\"\\\" || returnedStatus === \\\"cancelled\\\") {\\n    action.goTo(NODE_OUTCOME.RETRY);\\n    return;\\n  }\\n\\n  // Client-side error with Keyless error code\\n  if (returnedStatus.indexOf(\\\"error:\\\") === 0) {\\n    var code = returnedStatus.substring(6);\\n    logger.error(\\\"[P1RecognizeEnroll] client error: \\\" + code + \\\" user=\\\" + maskUser(username));\\n    action.goTo(outcomeForErrorCode(code));\\n    return;\\n  }\\n\\n  // Success — verify the JWT server-side\\n  if (returnedStatus === \\\"success\\\" && returnedJwt) {\\n    nodeState.putShared(\\\"p1RTransactionJwt\\\", returnedJwt);\\n\\n    if (VERIFY_JWT_ENABLED) {\\n      var result = verifyTransactionJwt(returnedJwt);\\n      if (result.verified) {\\n        nodeState.putShared(\\\"p1REnrollStatus\\\", \\\"verified\\\");\\n        logger.info(\\\"[P1RecognizeEnroll] success user=\\\" + maskUser(username));\\n        action.goTo(NODE_OUTCOME.SUCCESS);\\n      } else {\\n        logger.error(\\\"[P1RecognizeEnroll] JWT not verified user=\\\" + maskUser(username) + \\\": \\\" + result.error);\\n        nodeState.putShared(\\\"p1REnrollStatus\\\", \\\"unverified\\\");\\n        action.goTo(NODE_OUTCOME.ERROR);\\n      }\\n    } else {\\n      nodeState.putShared(\\\"p1REnrollStatus\\\", \\\"unverified\\\");\\n      action.goTo(NODE_OUTCOME.SUCCESS);\\n    }\\n    return;\\n  }\\n\\n  // Catch-all\\n  logger.error(\\\"[P1RecognizeEnroll] unexpected status=\\\" + returnedStatus + \\\" user=\\\" + maskUser(username));\\n  action.goTo(NODE_OUTCOME.ERROR);\\n\\n}());\\n\",\"serviceName\":\"c5a8d1b2e4f06a9b3c5d7e8f1a2b3c4d\",\"tags\":[],\"version\":1}"
          },
          "queryString": [],
          "url": "https://openam-frodo-dev.forgeblocks.com/am/json/node-designer/node-type/c5a8d1b2e4f06a9b3c5d7e8f1a2b3c4d-1"
        },
        "response": {
          "bodySize": 30257,
          "content": {
            "mimeType": "application/json;charset=UTF-8",
            "size": 30257,
            "text": "{\"_id\":\"c5a8d1b2e4f06a9b3c5d7e8f1a2b3c4d-1\",\"_rev\":\"568403071\",\"serviceName\":\"c5a8d1b2e4f06a9b3c5d7e8f1a2b3c4d\",\"version\":1,\"displayName\":\"PingOne Recognize Biometric Web Enrollment\",\"description\":\"Face biometric enrollment via PingOne Recognize WebSDK.\",\"outcomes\":[\"success\",\"retry\",\"error\",\"alreadyEnrolled\"],\"outputs\":[],\"inputs\":[],\"script\":\"/**\\n * ============================================================\\n *  PINGONE RECOGNIZE BIOMETRIC ENROLLMENT\\n *  PingOne AIC — Custom Node (Node Designer)\\n * ============================================================\\n *\\n *  Import via:  Journeys → Node Designer → Import  (or REST API)\\n *\\n *  NODE PROPERTIES (configured in Node Designer):\\n *    • tenantEnvironment        — SANDBOX | US | EUROPE | LATAM\\n *    • tenantName               — P1 Recognize tenant/customer name\\n *    • apiKey                   — P1 Recognize API key (supports ESV dot notation e.g. esv.p1recognize.apikey)\\n *    • publicKeyId              — Image encryption key ID\\n *    • publicKey                — Image encryption public key\\n *    • webSdkVersion            — Web SDK version to load (e.g. 2.3.0)\\n *    • sdkTheme                 — light | dark  (default: light)\\n *    • sdkLanguage              — Language override code (e.g. en, fr, de);\\n *                                 auto-detected from locale param / Accept-Language if blank\\n *    • enableCameraInstructions — Show camera instruction steps before capture (Boolean)\\n *    • finishedSubmitDelay      — ms to wait after success before form submit (default: 3000)\\n *    • errorSubmitDelay         — ms to wait after error before form submit (default: 3000)\\n *    • hidePoweredBy            — Remove 'Powered by Keyless' branding (Boolean)\\n *    • sdkThemeOptions          — JSON object for SDK colour overrides\\n *    • sdkLocalization          — JSON array of localization packs\\n *\\n *  NODE OUTCOMES:\\n *    • success         — biometric enrollment completed; transaction JWT validated\\n *    • error           — enrollment or JWT verification failed\\n *    • retry           — user cancelled / camera error / connection error\\n *    • alreadyEnrolled — user already has a biometric enrollment on record\\n *\\n *  SHARED-STATE INPUTS (prior node, e.g. Platform Username):\\n *    • username\\n *\\n *  SHARED-STATE OUTPUTS (written on success):\\n *    • p1RTransactionJwt  — signed JWT from P1 Recognize\\n *    • p1REnrollStatus    — \\\"enrolled\\\" | \\\"failed\\\"\\n *\\n *  Required CSP additions (vary by tenantEnvironment):\\n *    script-src   https://d3hz8ozgrmhn4r.cloudfront.net\\n *    connect-src  <AUTH_URL for selected environment>\\n *\\n * Author(s):\\n *    Mike Simon (@mjspi)\\n * ============================================================\\n */\\n\\n//// CONSTANTS\\nvar SDK_CDN_BASE = \\\"https://d3hz8ozgrmhn4r.cloudfront.net/sdk-web-components\\\";\\n\\nvar ENV_CONFIGS = {\\n  \\\"SANDBOX\\\": {\\n    AUTH_URL: \\\"https://authentication-service-sandbox.eks.core-production.keyless.technology\\\",\\n    OPS_URL:  \\\"https://operations-service-sandbox.eks.core-production.keyless.technology\\\"\\n  },\\n  \\\"US\\\": {\\n    AUTH_URL: \\\"https://authentication-service.eks.core-production.saas-us-east.keyless.technology\\\",\\n    OPS_URL:  \\\"https://api.eks.core-production.saas-us-east.keyless.technology\\\"\\n  },\\n  \\\"EUROPE\\\": {\\n    AUTH_URL: \\\"https://authentication-service.eks.core-production.keyless.technology\\\",\\n    OPS_URL:  \\\"https://api.keyless.io\\\"\\n  },\\n  \\\"LATAM\\\": {\\n    AUTH_URL: \\\"https://authentication-service.eks.core-production.latam.keyless.technology\\\",\\n    OPS_URL:  \\\"https://api.eks.core-production.latam.keyless.technology\\\"\\n  }\\n};\\n\\n//// PARAMETERS\\nvar envKey    = String(properties.tenantEnvironment || \\\"US\\\");\\nvar envConfig = ENV_CONFIGS[envKey] || ENV_CONFIGS[\\\"US\\\"];\\n\\n// Read properties first so derived URLs can reference them\\nvar P1R_API_KEY    = String(properties.apiKey       || \\\"\\\");\\nvar P1R_KEY_ID     = String(properties.publicKeyId  || \\\"\\\");\\nvar P1R_PUBLIC_KEY = String(properties.publicKey    || \\\"\\\");\\nvar P1R_CUSTOMER   = String(properties.tenantName   || \\\"\\\");\\n\\n// Derive service URLs from environment config\\nvar P1R_WS_URL           = envConfig.AUTH_URL.replace(\\\"https://\\\", \\\"wss://\\\");\\nvar P1R_ENROLL_CHECK_URL = envConfig.AUTH_URL + \\\"/v1/users/\\\" + P1R_CUSTOMER + \\\"/\\\";\\nvar P1R_VERIFY_URL       = envConfig.OPS_URL  + \\\"/v2/verify-jwt\\\";\\n\\nvar SDK_HIDE_POWERED_BY  = (properties.hidePoweredBy === true);\\nvar SDK_THEME            = String(properties.sdkTheme || \\\"light\\\").trim().toLowerCase();\\n// Detect language: locale query param → Accept-Language header → sdkLanguage property\\nvar SDK_LANGUAGE = (function () {\\n  // Helper: extract base language code from a BCP-47 tag (e.g. \\\"en-US\\\" → \\\"en\\\")\\n  function baseLang(tag) {\\n    return String(tag).trim().split(/[-_]/)[0].toLowerCase();\\n  }\\n  // 1. sdkLanguage property — explicit override takes highest priority\\n  var configured = String(properties.sdkLanguage || \\\"\\\").trim();\\n  if (configured) { return configured; }\\n  // 2. locale query parameter — matches AIC hosted page behaviour\\n  try {\\n    var localeParam = requestParameters.get(\\\"locale\\\");\\n    if (localeParam && localeParam.get(0)) {\\n      var lang = baseLang(localeParam.get(0));\\n      if (lang) { return lang; }\\n    }\\n  } catch (e) { /* binding unavailable */ }\\n  // 3. Accept-Language request header\\n  // Format: \\\"en-US,en;q=0.9,fr;q=0.8\\\" — take the first tag before any comma or semicolon\\n  try {\\n    var acceptLang = requestHeaders.get(\\\"Accept-Language\\\");\\n    if (acceptLang && acceptLang.get(0)) {\\n      var primary = String(acceptLang.get(0)).split(\\\",\\\")[0].split(\\\";\\\")[0].trim();\\n      var lang = baseLang(primary);\\n      if (lang) { return lang; }\\n    }\\n  } catch (e) { /* binding unavailable */ }\\n  // 4. Default to English\\n  return \\\"en\\\";\\n})();\\nvar SDK_CAMERA_INSTRUCTIONS  = (properties.enableCameraInstructions === true);\\nvar SDK_THEME_OPTIONS   = String(properties.sdkThemeOptions || \\\"\\\").trim();\\nvar SDK_LOCALIZATION    = String(properties.sdkLocalization || \\\"\\\").trim();\\n\\n// Optional: data string P1Recognize signs alongside the auth transaction.\\n// Required for the transactionJWT to be returned in the finished event.\\n// Defaults to the username if not set.\\nvar P1R_TRANSACTION_DATA = (nodeState.get(\\\"transactionData\\\") || \\\"\\\");\\n\\n// ── Keyless SDK (version-pinned, SRI-verified) ────────────────\\nvar SDK_VERSION           = String(properties.webSdkVersion || \\\"2.3.0\\\");\\nvar SDK_BASE_URL          = SDK_CDN_BASE + \\\"/\\\" + SDK_VERSION;\\nvar SDK_MAIN_URL = SDK_BASE_URL + \\\"/index.js\\\";\\n\\n// ── Options ───────────────────────────────────────────────────\\nvar VERIFY_JWT_ENABLED       = (envKey !== \\\"SANDBOX\\\"); // Auto-disabled in Sandbox\\nvar FINISHED_SUBMIT_DELAY_MS = (properties.finishedSubmitDelay != null ? Number(properties.finishedSubmitDelay) : 3000);\\nvar ERROR_SUBMIT_DELAY_MS    = (properties.errorSubmitDelay    != null ? Number(properties.errorSubmitDelay)    : 3000);\\n\\n//// OUTCOMES\\nvar NODE_OUTCOME = { SUCCESS: \\\"success\\\", ERROR: \\\"error\\\", RETRY: \\\"retry\\\", ALREADY_ENROLLED: \\\"alreadyEnrolled\\\" };\\nvar RETRY_CODES = [\\\"CAMERA_PERMISSION_DENIED\\\", \\\"CAMERA_NOT_FOUND\\\", \\\"WEBSOCKET_CLOSED\\\", \\\"CONNECTION_ERROR\\\"];\\n\\n// ── Callback identifiers (must match order of nameCallback registration below)\\nvar CB_JWT_ID    = \\\"p1RTransactionJwt\\\";\\nvar CB_STATUS_ID = \\\"p1RStatus\\\";\\n\\n// ─────────────────────────────────────────────────────────────\\n//  buildClientScript  — generates the browser-side JS injected\\n//  via ScriptTextOutputCallback on the first pass.\\n// ─────────────────────────────────────────────────────────────\\nfunction buildClientScript(username) {\\n\\n  // Escape a value for safe embedding in a single-quoted JS string.\\n  // Handles backslashes, single quotes, and newlines (common in PEM keys).\\n  function esc(v) {\\n    return String(v)\\n      .replace(/\\\\\\\\/g,  \\\"\\\\\\\\\\\\\\\\\\\")\\n      .replace(/'/g,   \\\"\\\\\\\\'\\\")\\n      .replace(/\\\\r/g,  \\\"\\\\\\\\r\\\")\\n      .replace(/\\\\n/g, \\\"\\\\\\\\n\\\")\\n      // Use split/join for line-terminator chars — regex literals containing\\n      // \\\\u2028/\\\\u2029 become raw LineTerminators after JSON decode, causing\\n      // Rhino parse errors. split().join() avoids regex literal parsing entirely.\\n      .split(\\\"\\\\u0000\\\").join(\\\"\\\\\\\\0\\\")\\n      .split(\\\"\\\\u2028\\\").join(\\\"\\\\\\\\u2028\\\")\\n      .split(\\\"\\\\u2029\\\").join(\\\"\\\\\\\\u2029\\\");\\n  }\\n\\n  // Build structured transaction data object for auditing and traceability.\\n  // Embeds the AIC journey transaction ID alongside any clientData from state.\\n  var _h  = (typeof requestHeaders !== 'undefined') ? requestHeaders : null;\\n  var _id = (_h && _h.get('x-forgerock-transactionid')) ? _h.get('x-forgerock-transactionid').get(0) : \\\"no-tx-id\\\";\\n  var _txObj = { \\\"x-forgerock-transactionid\\\": _id };\\n  if (P1R_TRANSACTION_DATA) { _txObj[\\\"clientData\\\"] = P1R_TRANSACTION_DATA; }\\n  var txData = JSON.stringify(_txObj);\\n\\n  return [\\n    \\\"(function () {\\\",\\n    \\\"  'use strict';\\\",\\n    \\\"  function init() {\\\",\\n    \\\"    if (document.getElementById('kl-enroll-overlay')) { return; }\\\",\\n\\n    // Minimal style block — just the spinner keyframes\\n    \\\"    var klTheme = document.createElement('style');\\\",\\n    \\\"    klTheme.setAttribute('data-kl-enroll', '');\\\",\\n    \\\"    klTheme.textContent = '@keyframes klSpin{to{transform:rotate(360deg)}}';\\\",\\n    \\\"    document.head.appendChild(klTheme);\\\",\\n\\n    // 2. Inline wrapper — inserted into the callback container so the\\n    // Page Node's logo/title (rendered above the form) remain visible.\\n    \\\"    var overlay = document.createElement('div');\\\",\\n    \\\"    overlay.id = 'kl-enroll-overlay';\\\",\\n    \\\"    overlay.style.cssText = 'display:flex;justify-content:center;';\\\",\\n\\n    // Card\\n    \\\"    var card = document.createElement('div');\\\",\\n    \\\"    card.style.cssText = 'max-width:440px;width:100%;box-sizing:border-box;\\\" +\\n      \\\"display:flex;flex-direction:column;align-items:center;gap:20px';\\\",\\n\\n    // Status banner\\n    \\\"    var banner = document.createElement('div');\\\",\\n    \\\"    banner.style.cssText = 'display:none;font-size:13px;padding:10px 14px;\\\" +\\n      \\\"border-radius:8px;width:100%;text-align:center;box-sizing:border-box';\\\",\\n\\n    // Loading spinner — reuses @keyframes klSpin from klTheme style block above\\n    \\\"    var spinnerWrap = document.createElement('div');\\\",\\n    \\\"    spinnerWrap.id = 'kl-enroll-loading';\\\",\\n    \\\"    spinnerWrap.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:12px;padding:30px 0';\\\",\\n    \\\"    spinnerWrap.innerHTML = '<div style=\\\\\\\"width:40px;height:40px;border:4px solid #dde3f0;\\\" +\\n      \\\"border-top-color:#003CB4;border-radius:50%;animation:klSpin 0.8s linear infinite\\\\\\\"></div>\\\" +\\n      \\\"<span style=\\\\\\\"color:#888;font-size:13px\\\\\\\">Loading biometric module\\\\u2026</span>';\\\",\\n\\n    // kl-enroll component\\n    \\\"    var klEnroll = document.createElement('kl-enroll');\\\",\\n    \\\"    klEnroll.setAttribute('customer',                   '\\\" + esc(P1R_CUSTOMER)   + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('ws-url',                     '\\\" + esc(P1R_WS_URL)     + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('key-id',                     '\\\" + esc(P1R_KEY_ID)     + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('public-key',                 '\\\" + esc(P1R_PUBLIC_KEY) + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('username',                   '\\\" + esc(username)           + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('transaction-data',           '\\\" + esc(txData)             + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('lang',  '\\\" + esc(SDK_LANGUAGE) + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('size',  '320');\\\",\\n    \\\"    klEnroll.setAttribute('theme', '\\\" + esc(SDK_THEME)    + \\\"');\\\",\\n    \\\"    klEnroll.setAttribute('operation-id', '\\\" + esc(_id)   + \\\"');\\\",\\n    // \\\"    klEnroll.style.cssText = 'display:none;width:360px;border-radius:10px;overflow:hidden;margin:0 auto';\\\",\\n    \\\"    klEnroll.style.cssText = 'display:none;width:360px;max-width:360px;flex-shrink:0;border-radius:10px;overflow:hidden;margin:0 auto';\\\",\\n\\n    // ── Optional SDK customisations ─────────────────────────────\\n    \\\"    var _themeOpts = '\\\" + esc(SDK_THEME_OPTIONS) + \\\"';\\\",\\n    \\\"    if (_themeOpts) { try { klEnroll.themeOptions = JSON.parse(_themeOpts); } catch (e) {} }\\\",\\n    \\\"    var _locRaw = '\\\" + esc(SDK_LOCALIZATION) + \\\"';\\\",\\n    \\\"    if (_locRaw) {\\\",\\n    \\\"      try {\\\",\\n    \\\"        var _locEntries = JSON.parse(_locRaw);\\\",\\n    \\\"        var _locPacks = [];\\\",\\n    \\\"        for (var _i = 0; _i < _locEntries.length; _i++) {\\\",\\n    \\\"          var _e = _locEntries[_i];\\\",\\n    \\\"          _locPacks.push({ data: _e.data, language: _e.language });\\\",\\n    \\\"        }\\\",\\n    \\\"        klEnroll.localizationPacks = _locPacks;\\\",\\n    \\\"      } catch (e) {}\\\",\\n    \\\"    }\\\",\\n  ].concat(SDK_CAMERA_INSTRUCTIONS ? [\\n    \\\"    klEnroll.setAttribute('enable-camera-instructions', '');\\\",\\n  ] : []).concat(SDK_HIDE_POWERED_BY ? [\\n    \\\"    var _pb = document.createElement('span');\\\",\\n    \\\"    _pb.setAttribute('slot', 'powered-by');\\\",\\n    \\\"    klEnroll.appendChild(_pb);\\\",\\n  ] : []).concat([\\n\\n    // Cancel button\\n\\n    // Cancel button\\n    \\\"    var cancelBtn = document.createElement('button');\\\",\\n    \\\"    cancelBtn.textContent = 'Cancel';\\\",\\n    \\\"    cancelBtn.type = 'button';\\\",\\n    \\\"    cancelBtn.style.cssText = 'background:none;border:1px solid #003CB4;color:#003CB4;\\\" +\\n      \\\"padding:9px 24px;border-radius:6px;font-size:14px;cursor:pointer;margin-bottom:12px';\\\",\\n\\n    // Assemble\\n    \\\"    card.appendChild(banner);\\\",\\n    \\\"    card.appendChild(spinnerWrap);\\\",\\n    \\\"    card.appendChild(klEnroll);\\\",\\n    \\\"    card.appendChild(cancelBtn);\\\",\\n    \\\"    overlay.appendChild(card);\\\",\\n    \\\"    var klAnchor = document.querySelector('.fr-field, .callback, .form-group, .fr-center-card .card-body');\\\",\\n    \\\"    if (klAnchor) {\\\",\\n    \\\"      klAnchor.parentNode.insertBefore(overlay, klAnchor);\\\",\\n      \\\"      klAnchor.style.display = 'none';\\\",\\n    \\\"    } else {\\\",\\n    \\\"      document.body.appendChild(overlay);\\\",\\n    \\\"    }\\\",\\n\\n    // Callback slot discovery\\n    \\\"    var _allCbEls = document.querySelectorAll('input[name^=\\\\\\\"callback_\\\\\\\"]');\\\",\\n    \\\"    var _emptyCbs = [];\\\",\\n    \\\"    for (var _ci = 0; _ci < _allCbEls.length; _ci++) {\\\",\\n    \\\"      if (_allCbEls[_ci].value === '') { _emptyCbs.push(_allCbEls[_ci].name); }\\\",\\n    \\\"    }\\\",\\n    \\\"    var KL_CB_JWT    = _emptyCbs[_emptyCbs.length - 2] || 'callback_2';\\\",\\n    \\\"    var KL_CB_STATUS = _emptyCbs[_emptyCbs.length - 1] || 'callback_3';\\\",\\n\\n    // submitForm\\n    \\\"    function klSet(name, value) {\\\",\\n    \\\"      var el = document.querySelector('[name=\\\\\\\"' + name + '\\\\\\\"]');\\\",\\n    \\\"      if (!el) { return; }\\\",\\n    \\\"      var setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;\\\",\\n    \\\"      setter.call(el, value);\\\",\\n    \\\"      el.dispatchEvent(new Event('input',  { bubbles: true }));\\\",\\n    \\\"      el.dispatchEvent(new Event('change', { bubbles: true }));\\\",\\n    \\\"    }\\\",\\n    \\\"    var submitted = false;\\\",\\n    \\\"    function submitForm(jwt, status) {\\\",\\n    \\\"      if (submitted) { return; }\\\",\\n    \\\"      submitted = true;\\\",\\n    \\\"      klSet(KL_CB_JWT,    jwt    || '');\\\",\\n    \\\"      klSet(KL_CB_STATUS, status || '');\\\",\\n    \\\"      setTimeout(function () {\\\",\\n    \\\"        var btn = document.querySelector('button[type=submit],input[type=submit],#loginButton_0');\\\",\\n    \\\"        if (btn) { btn.click(); }\\\",\\n    \\\"      }, 300);\\\",\\n    \\\"      setTimeout(function () {\\\",\\n    \\\"        var el = document.getElementById('kl-enroll-overlay');\\\",\\n    \\\"        if (el && el.parentNode) { el.parentNode.removeChild(el); }\\\",\\n    \\\"        var th = document.querySelector('style[data-kl-enroll]');\\\",\\n    \\\"        if (th && th.parentNode) { th.parentNode.removeChild(th); }\\\",\\n    \\\"      }, 800);\\\",\\n    \\\"    }\\\",\\n\\n    // showBanner helper\\n    \\\"    function showBanner(msg, isSuccess) {\\\",\\n    \\\"      banner.textContent      = msg;\\\",\\n    \\\"      banner.style.background = isSuccess ? '#f0fff4' : '#fff0f0';\\\",\\n    \\\"      banner.style.color      = isSuccess ? '#27ae60' : '#c0392b';\\\",\\n    \\\"      banner.style.border     = isSuccess ? '1px solid #b2dfdb' : '1px solid #f5c6c6';\\\",\\n    \\\"      banner.style.display    = 'block';\\\",\\n    \\\"    }\\\",\\n\\n    // Button handler\\n\\n    // Button handler\\n    \\\"    cancelBtn.addEventListener('click', function () { submitForm('', 'cancelled'); });\\\",\\n\\n    // finished — biometric succeeded\\n    \\\"    var finishedFired = false;\\\",\\n    \\\"    klEnroll.addEventListener('finished', function (e) {\\\",\\n    \\\"      finishedFired = true;\\\",\\n    \\\"      var jwt = (e.detail || {}).transactionJWT || '';\\\",\\n    \\\"      showBanner('Enrollment successful! Redirecting\\\\u2026', true);\\\",\\n    \\\"      cancelBtn.disabled = true;\\\",\\n    \\\"      setTimeout(function () { submitForm(jwt, 'success'); }, \\\" + FINISHED_SUBMIT_DELAY_MS + \\\");\\\",\\n    \\\"    });\\\",\\n\\n    // error — biometric failed\\n    \\\"    var errorFired = false;\\\",\\n    \\\"    klEnroll.addEventListener('error', function (e) {\\\",\\n    \\\"      errorFired = true;\\\",\\n    \\\"      var d = e.detail || {};\\\",\\n    \\\"      showBanner(d.message || 'An error occurred during enrollment.', false);\\\",\\n    \\\"      setTimeout(function () { submitForm('', 'error:' + (d.code || 'UNKNOWN')); }, \\\" + ERROR_SUBMIT_DELAY_MS + \\\");\\\",\\n    \\\"    });\\\",\\n\\n    // close — only act if neither finished nor error already fired\\n    \\\"    klEnroll.addEventListener('close', function () {\\\",\\n    \\\"      if (finishedFired || errorFired) { return; }\\\",\\n    \\\"      submitForm('', 'cancelled');\\\",\\n    \\\"    });\\\",\\n\\n    // Load SDK — skip injection if custom element already registered (retry case)\\n    \\\"    if (typeof customElements !== 'undefined' && customElements.get('kl-enroll')) {\\\",\\n    \\\"      document.getElementById('kl-enroll-loading').style.display = 'none';\\\",\\n    \\\"      klEnroll.style.display = 'flex';\\\",\\n    \\\"    } else {\\\",\\n    \\\"      var sdk = document.createElement('script');\\\",\\n    \\\"      sdk.type    = 'module';\\\",\\n    \\\"      sdk.src     = '\\\" + esc(SDK_MAIN_URL) + \\\"';\\\",\\n    \\\"      sdk.onload  = function () {\\\",\\n    \\\"        document.getElementById('kl-enroll-loading').style.display = 'none';\\\",\\n    \\\"        klEnroll.style.display = 'flex';\\\",\\n    \\\"      };\\\",\\n    \\\"      sdk.onerror = function () {\\\",\\n    \\\"        showBanner('Failed to load the biometric module. Please refresh.', false);\\\",\\n    \\\"      };\\\",\\n    \\\"      document.head.appendChild(sdk);\\\",\\n    \\\"    }\\\",\\n    \\\"  }\\\",\\n\\n    \\\"  if (document.readyState === 'loading') {\\\",\\n    \\\"    document.addEventListener('DOMContentLoaded', init);\\\",\\n    \\\"  } else { init(); }\\\",\\n    \\\"}());\\\"\\n  ]).join(\\\"\\\\n\\\");\\n}\\n\\n//// UTILITIES\\n// ─────────────────────────────────────────────────────────────\\n//  maskUser — partial-mask a username for log output (PII hygiene)\\n// ─────────────────────────────────────────────────────────────\\nfunction maskUser(u) {\\n  var s = String(u || \\\"\\\");\\n  return s.length > 3 ? s.substring(0, 3) + \\\"***\\\" : \\\"***\\\";\\n}\\n\\n// ─────────────────────────────────────────────────────────────\\n//  checkEnrollmentStatus  — returns true if user is already enrolled\\n// ─────────────────────────────────────────────────────────────\\nfunction checkEnrollmentStatus(username) {\\n  try {\\n    var url      = P1R_ENROLL_CHECK_URL + encodeURIComponent(username);\\n    var response = httpClient.send(url, {\\n      method  : \\\"GET\\\",\\n      headers : { \\\"Kl-Api-Key\\\": P1R_API_KEY }\\n    }).get();\\n    if (response.status === 200) {\\n      var body = JSON.parse(response.text());\\n      return { success: true, isEnrolled: (body.isEnrolled === true) };\\n    }\\n    logger.error(\\\"[P1RecognizeEnroll] enrollment check HTTP \\\" + response.status + \\\" user=\\\" + maskUser(username));\\n    return { success: false };\\n  } catch (e) {\\n    logger.error(\\\"[P1RecognizeEnroll] enrollment check exception: \\\" + e);\\n    return { success: false };\\n  }\\n}\\n\\n// ─────────────────────────────────────────────────────────────\\n//  verifyTransactionJwt  — server-side JWT verification\\n// ─────────────────────────────────────────────────────────────\\nfunction verifyTransactionJwt(jwt) {\\n  try {\\n    var response = httpClient.send(P1R_VERIFY_URL, {\\n      method  : \\\"POST\\\",\\n      headers : { \\\"Content-Type\\\": \\\"application/json\\\", \\\"X-Api-Key\\\": P1R_API_KEY },\\n      body    : JSON.stringify({ message: jwt })\\n    }).get();\\n\\n    if (response.status === 200) {\\n      return { verified: true };\\n    }\\n    logger.error(\\\"[P1RecognizeEnroll] verify HTTP \\\" + response.status);\\n    return { verified: false, error: \\\"HTTP_\\\" + response.status };\\n  } catch (e) {\\n    logger.error(\\\"[P1RecognizeEnroll] verify exception: \\\" + e);\\n    return { verified: false, error: String(e) };\\n  }\\n}\\n\\n// ─────────────────────────────────────────────────────────────\\n//  outcomeForErrorCode\\n// ─────────────────────────────────────────────────────────────\\nfunction outcomeForErrorCode(code) {\\n  var i;\\n  for (i = 0; i < RETRY_CODES.length; i++) {\\n    if (RETRY_CODES[i] === code) { return NODE_OUTCOME.RETRY; }\\n  }\\n  return NODE_OUTCOME.ERROR;\\n}\\n\\n//// MAIN\\n// ─────────────────────────────────────────────────────────────\\n//  MAIN\\n// ─────────────────────────────────────────────────────────────\\n(function () {\\n\\n  // ── First pass: serve the biometric UI ─────────────────────\\n  if (callbacks.isEmpty()) {\\n    var username = nodeState.get(\\\"username\\\");\\n    if (!username) {\\n      logger.error(\\\"[P1RecognizeEnroll] 'username' not found in nodeState — ensure a Platform Username node precedes this node.\\\");\\n      action.goTo(NODE_OUTCOME.ERROR);\\n      return;\\n    }\\n    // Check if user is already enrolled before showing enrollment UI\\n    var enrollCheck = checkEnrollmentStatus(username);\\n    if (!enrollCheck.success) {\\n      logger.error(\\\"[P1RecognizeEnroll] could not verify enrollment status for user=\\\" + maskUser(username));\\n      action.goTo(NODE_OUTCOME.ERROR);\\n      return;\\n    }\\n    if (enrollCheck.isEnrolled) {\\n      logger.warn(\\\"[P1RecognizeEnroll] user already enrolled user=\\\" + maskUser(username));\\n      action.goTo(NODE_OUTCOME.ALREADY_ENROLLED);\\n      return;\\n    }\\n    callbacksBuilder.scriptTextOutputCallback(buildClientScript(username));\\n    callbacksBuilder.nameCallback(CB_JWT_ID);\\n    callbacksBuilder.nameCallback(CB_STATUS_ID);\\n    return;\\n  }\\n\\n  // ── Second pass: process the enrollment result ──────────────\\n  var username       = nodeState.get(\\\"username\\\");\\n  var cbs            = callbacks.getNameCallbacks();\\n  var returnedJwt    = String(cbs.get(0) || \\\"\\\");\\n  var returnedStatus = String(cbs.get(1) || \\\"\\\");\\n\\n  // Cancelled or timed out\\n  if (returnedStatus === \\\"\\\" || returnedStatus === \\\"cancelled\\\") {\\n    action.goTo(NODE_OUTCOME.RETRY);\\n    return;\\n  }\\n\\n  // Client-side error with Keyless error code\\n  if (returnedStatus.indexOf(\\\"error:\\\") === 0) {\\n    var code = returnedStatus.substring(6);\\n    logger.error(\\\"[P1RecognizeEnroll] client error: \\\" + code + \\\" user=\\\" + maskUser(username));\\n    action.goTo(outcomeForErrorCode(code));\\n    return;\\n  }\\n\\n  // Success — verify the JWT server-side\\n  if (returnedStatus === \\\"success\\\" && returnedJwt) {\\n    nodeState.putShared(\\\"p1RTransactionJwt\\\", returnedJwt);\\n\\n    if (VERIFY_JWT_ENABLED) {\\n      var result = verifyTransactionJwt(returnedJwt);\\n      if (result.verified) {\\n        nodeState.putShared(\\\"p1REnrollStatus\\\", \\\"verified\\\");\\n        logger.info(\\\"[P1RecognizeEnroll] success user=\\\" + maskUser(username));\\n        action.goTo(NODE_OUTCOME.SUCCESS);\\n      } else {\\n        logger.error(\\\"[P1RecognizeEnroll] JWT not verified user=\\\" + maskUser(username) + \\\": \\\" + result.error);\\n        nodeState.putShared(\\\"p1REnrollStatus\\\", \\\"unverified\\\");\\n        action.goTo(NODE_OUTCOME.ERROR);\\n      }\\n    } else {\\n      nodeState.putShared(\\\"p1REnrollStatus\\\", \\\"unverified\\\");\\n      action.goTo(NODE_OUTCOME.SUCCESS);\\n    }\\n    return;\\n  }\\n\\n  // Catch-all\\n  logger.error(\\\"[P1RecognizeEnroll] unexpected status=\\\" + returnedStatus + \\\" user=\\\" + maskUser(username));\\n  action.goTo(NODE_OUTCOME.ERROR);\\n\\n}());\\n\",\"errorOutcome\":false,\"tags\":[],\"properties\":{\"apiKey\":{\"title\":\"API Key\",\"description\":\"API Key generated in the P1Recognize tenant under Access Control. Supports ESV references using dot notation e.g. esv.p1recognize.apikey\",\"type\":\"STRING\",\"required\":true,\"multivalued\":false},\"enableCameraInstructions\":{\"title\":\"Enable Camera Instructions\",\"description\":\"Show camera instruction steps before biometric capture begins\",\"type\":\"BOOLEAN\",\"required\":false,\"defaultValue\":true,\"multivalued\":false},\"errorSubmitDelay\":{\"title\":\"Error Submit Delay (ms)\",\"description\":\"Milliseconds to wait after a biometric error before submitting. Default 3000. Set to 0 to submit immediately.\",\"type\":\"NUMBER\",\"required\":false,\"defaultValue\":3000,\"multivalued\":false},\"finishedSubmitDelay\":{\"title\":\"Finished Submit Delay (ms)\",\"description\":\"Milliseconds to wait after a successful biometric before submitting. Default 3000. Set to 0 to submit immediately.\",\"type\":\"NUMBER\",\"required\":false,\"defaultValue\":3000,\"multivalued\":false},\"hidePoweredBy\":{\"title\":\"Hide Powered By Keyless\",\"description\":\"Hides the PoweredBy footer displayed on all screens.\",\"type\":\"BOOLEAN\",\"required\":false,\"defaultValue\":true,\"multivalued\":false},\"publicKey\":{\"title\":\"Public Key\",\"description\":\"The public key used as part of the image encryption process. The publicKey is available via an HTTP GET to the {{baseURL}}/v1/customers/{{tenant_name}}}/image-encryption endpoint. Remove all \\\\n newline characters and the -----BEGIN PUBLIC KEY----- and -----END PUBLIC KEY----- tags from the publicKey before using it in the node configuration. \",\"type\":\"STRING\",\"required\":true,\"multivalued\":false},\"publicKeyId\":{\"title\":\"Public Key ID\",\"description\":\"The ID of the public key used as part of the image encryption process. The keyID is available via an HTTP GET to the {{baseURL}}/v1/customers/{{tenant_name}}}/image-encryption endpoint.\",\"type\":\"STRING\",\"required\":true,\"multivalued\":false},\"sdkLanguage\":{\"title\":\"SDK Language (override)\",\"description\":\"Explicit language override. If set, takes precedence over auto-detection. Leave blank for auto-detection. (e.g. en, fr, de)\",\"type\":\"STRING\",\"required\":false,\"multivalued\":false},\"sdkLocalization\":{\"title\":\"SDK Localization\",\"description\":\"JSON to enable customization and localisation of text displayed by P1Recognize UI.  Multiple language tags are supported. e.g. [\\n  {\\\"language\\\":\\\"en\\\",\\\"steps\\\":{\\\"camera-instructions\\\":{\\\"headline\\\":\\\"...\\\",\\\"text\\\":\\\"...\\\"}}},\\n  {\\\"language\\\":\\\"fr\\\",\\\"steps\\\":{\\\"camera-instructions\\\":{\\\"headline\\\":\\\"...\\\",\\\"text\\\":\\\"...\\\"}}}\\n]\",\"type\":\"STRING\",\"required\":false,\"multivalued\":false},\"sdkTheme\":{\"title\":\"SDK Theme\",\"description\":\"The Web SDK supports both light and dark themes.\",\"type\":\"STRING\",\"required\":true,\"defaultValue\":\"LIGHT\",\"options\":{\"DARK\":\"dark\",\"LIGHT\":\"light\"},\"multivalued\":false},\"sdkThemeOptions\":{\"title\":\"SDK Theme Options\",\"description\":\"JSON to align to UX theme option changes. e.g. {\\\"colors\\\":{\\\"light\\\":{\\\"primary\\\":\\\"#1E69D2\\\",\\\"onPrimary\\\":\\\"#fff\\\",\\\"surface\\\":\\\"#fff\\\",\\\"onSurface\\\":\\\"#000\\\"}}}).  \",\"type\":\"STRING\",\"required\":false,\"multivalued\":false},\"tenantEnvironment\":{\"title\":\"P1 Recognize Tenant Region\",\"description\":\"The regional location of the provisioned P1Recognize tenant.\",\"type\":\"STRING\",\"required\":true,\"defaultValue\":\"US\",\"options\":{\"EUROPE\":\"EUROPE\",\"LATAM\":\"LATAM\",\"SANDBOX\":\"SANDBOX\",\"US\":\"US\"},\"multivalued\":false},\"tenantName\":{\"title\":\"P1 Recognize Tenant Name\",\"description\":\"The P1Recognize tenant name, shown as customer name within the P1Recognize tenant.\",\"type\":\"STRING\",\"required\":true,\"multivalued\":false},\"webSdkVersion\":{\"title\":\"Web SDK Version\",\"description\":\"Version of the P1Recognize Web SDK. Default is 2.3.0.\",\"type\":\"STRING\",\"required\":true,\"defaultValue\":\"2.3.0\",\"multivalued\":false}}}"
