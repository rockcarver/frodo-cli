        "name": "oreo",
        "value": "original",
        "domain": ".scheuber.io",
        "path": "/",
        "maxAge": 3600,
        "useHttpOnlyCookie": true,
        "useSecureCookie": true,
        "sameSite": "NONE"
    };
  
      var script = "";
    script += "Array.prototype.slice.call(";
    script += "    document.getElementsByTagName('input')";
