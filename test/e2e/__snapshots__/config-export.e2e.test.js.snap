        " */",
        "",
        "/*",
        " * Template/default script for SAML2 SP Adapter scripted plugin.",
        " */",
        "",
        "/*",
        " * Available variables for preSingleSignOnRequest:",
        " *     hostedEntityId",
        " *     idpEntityId",
        " *     realm",
        " *     request",
        " *     response",
        " *     authnRequest",
