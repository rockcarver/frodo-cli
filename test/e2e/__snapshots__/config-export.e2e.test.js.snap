{
  "script": {
    "3043cd81-2f2f-4972-9b0c-aaa694dcdba3": {
      "_id": "3043cd81-2f2f-4972-9b0c-aaa694dcdba3",
      "context": "AUTHENTICATION_TREE_DECISION_NODE",
      "default": false,
      "description": "null",
