        "}",
        "",
        "/**",
        " * Invoked after the SAML2 Response object is created, but before it is signed/encrypted.",
        " *",
        " * Available bindings:",
        " * hostedEntityId - String",
        " * realm - String",
        " * idpAdapterScriptHelper - IdpAdapterNextGenScriptHelper",
        " * request - Map",
