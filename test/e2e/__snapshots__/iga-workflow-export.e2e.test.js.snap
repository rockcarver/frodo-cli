                  "outcome": "AutoApprove",
                  "step": "scriptTask-e8842de66fbb",
                },
                {
                  "condition": [
                    "skipApproval == false",
                  ],
                  "outcome": "Approval",
                  "step": "approvalTask-74cf85c35437",
                },
              ],
              "script": [
                "logger.info("This is exclusive gateway");",
              ],
            },
            "type": "scriptTask",
          },
        ],
        "type": "provisioning",
      },
    },
  },
}
`;

