                "            }",
                "        };",
                "        var queryParam = {",
                "            '_action': "publish"",
                "        }",
                "        openidm.action('iga/governance/requests/roleRemove', 'POST', newRequestPayload, queryParam)",
                "     }catch(e){",
                "         logger.info('Create Removal Request creation failed')",
                "     }",
                "    }",
              ],
            },
            "type": "scriptTask",
          },
        ],
        "type": "provisioning",
      },
    },
  },
}
`;

