              "nextStep": [
                {
                  "condition": [
                    "enableEndWait == true",
                  ],
                  "outcome": "hasEndDate",
                  "step": "scriptTask-91769554db51",
                },
                {
                  "condition": [
                    "enableEndWait == false",
                  ],
