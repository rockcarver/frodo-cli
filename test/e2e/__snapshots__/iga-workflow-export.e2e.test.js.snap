              ],
              "events": {
                "expirationDate": 7,
                "expirationDateType": "duration",
                "expirationDateVariable": "",
                "expirationTimeSpan": "day(s)",
                "reminderDate": 3,
                "reminderTimeSpan": "day(s)",
              },
            },
            "exclusiveGateway-67a954f33919": {},
