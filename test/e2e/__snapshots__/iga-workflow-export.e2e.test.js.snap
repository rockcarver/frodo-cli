                    ],
                  },
                  "frequency": 3,
                  "notification": "requestReminder",
                },
              },
              "nextStep": [
                {
                  "condition": null,
                  "outcome": "APPROVE",
                  "step": "scriptTask-ba009484a101",
                },
                {
                  "condition": null,
                  "outcome": "REJECT",
