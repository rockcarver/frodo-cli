                  "step": "scriptTask-3eab1948f1ec",
                },
              ],
              "resumeDate": {
                "isExpression": true,
                "value": [
                  "requestIndex.request.common.startDate",
                ],
              },
            },
          },
          {
            "displayName": "Has End Date",
            "name": "inclusiveGateway-d18d59004c0c",
            "scriptTask": {
              "gatewayType": "inclusive",
              "language": "javascript",
              "nextStep": [
                {
                  "condition": [
                    "enableEndWait == true",
                  ],
                  "outcome": "hasEndDate",
