exports[`frodo config-manager pull all "frodo config-manager pull all -C test/e2e/fr-config-manager-pull-config -D allDir2 -m forgeops": should export all config in fr-config-manager style": allDir2/schedules/taskscan_activate/taskscan_activate.js 1`] = `
"var patch = [{ "operation" : "replace", "field" : "/accountStatus", "value" : "active" }];

logger.debug("Performing Activate Account Task on {} ({})", input.mail, objectID);

openidm.patch(objectID, null, patch); true;
"
`;

exports[`frodo config-manager pull all "frodo config-manager pull all -C test/e2e/fr-config-manager-pull-config -D allDir2 -m forgeops": should export all config in fr-config-manager style": allDir2/schedules/taskscan_activate/taskscan_activate.json 1`] = `
{
  "_id": "schedule/taskscan_activate",
  "concurrentExecution": false,
  "enabled": false,
  "invokeContext": {
    "numberOfThreads": 5,
    "scan": {
      "_queryFilter": "((/activeDate le "\${Time.nowWithOffset}") AND (!(/inactiveDate pr) or /inactiveDate ge "\${Time.nowWithOffset}"))",
      "object": "managed/user",
      "recovery": {
        "timeout": "10m",
      },
      "taskState": {
        "completed": "/activateAccount/task-completed",
        "started": "/activateAccount/task-started",
      },
    },
    "task": {
      "script": {
        "file": "taskscan_activate.js",
        "globals": {},
        "type": "text/javascript",
      },
    },
    "waitForCompletion": false,
  },
  "invokeService": "taskscanner",
  "persisted": true,
  "repeatInterval": 86400000,
  "type": "simple",
}
`;

exports[`frodo config-manager pull all "frodo config-manager pull all -C test/e2e/fr-config-manager-pull-config -D allDir2 -m forgeops": should export all config in fr-config-manager style": allDir2/schedules/taskscan_expire/taskscan_expire.js 1`] = `
"var patch = [{ "operation" : "replace", "field" : "/accountStatus", "value" : "inactive" }];

logger.debug("Performing Expire Account Task on {} ({})", input.mail, objectID);

openidm.patch(objectID, null, patch); true;
"
`;

